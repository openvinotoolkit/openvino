#version 450
// Native Vulkan kernel: Eltwise Add (f32), elementwise.
// binding 0: input0, binding 1: input1, binding 2: output.
// push constants [0]: element count.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer In0 { float data[]; } in0;
layout(set = 0, binding = 1, std430) buffer In1 { float data[]; } in1;
layout(set = 0, binding = 2, std430) buffer Out0 { float data[]; } out0;

layout(push_constant) uniform Params {
    uint total;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.total)
        return;
    out0.data[gid] = in0.data[gid] + in1.data[gid];
}