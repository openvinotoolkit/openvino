#version 450
// Native Vulkan kernel: QuickGELU (f32), elementwise: x * sigmoid(1.702x).
// binding 0: input, binding 1: output.
// push constants [0]: element count.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer In0 { float data[]; } in0;
layout(set = 0, binding = 1, std430) buffer Out0 { float data[]; } out0;

layout(push_constant) uniform Params {
    uint total;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.total)
        return;
    const float x = in0.data[gid];
    out0.data[gid] = x / (1.0f + exp(-1.702f * x));
}
