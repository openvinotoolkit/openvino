#version 450
// Native Vulkan kernel: RMSNorm (f32) along the LAST axis (contiguous lines):
//   out[l,i] = x[l,i] / sqrt(mean(x[l,:]^2) + eps) * weight[i]
// binding 0: input, binding 1: weight [len], binding 2: output.
// push constants: lines, len; push float alpha holds eps.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer In0 { float data[]; } in0;
layout(set = 0, binding = 1, std430) buffer W0 { float data[]; } w0;
layout(set = 0, binding = 2, std430) buffer Out0 { float data[]; } out0;

layout(push_constant, std430) uniform Params {
    uint lines;
    uint len;
    float eps;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.lines)
        return;

    const uint base = gid * params.len;
    float ss = 0.0f;
    for (uint i = 0u; i < params.len; ++i)
        ss += in0.data[base + i] * in0.data[base + i];
    const float inv = 1.0f / sqrt(ss / float(params.len) + params.eps);
    for (uint i = 0u; i < params.len; ++i)
        out0.data[base + i] = in0.data[base + i] * inv * w0.data[i];
}
