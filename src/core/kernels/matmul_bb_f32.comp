#version 450
// Native Vulkan kernel: pairwise-batched MatMul (f32),
// A [B,M,K] x B [Bb,K,N] -> O [B,M,N]. Every batch element owns its matrix —
// the attention pattern (per-head Q·K^T and P·V). GQA support: when
// Bb == 1 the single B matrix is shared by every A batch row; otherwise
// Bb must equal B.
// binding 0: A, binding 1: B, binding 2: output.
// push constants: [0]=M [1]=N [2]=K [3]=total_out [4]=batch [5]=b_batch

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer In0 { float data[]; } a;
layout(set = 0, binding = 1, std430) buffer In1 { float data[]; } b;
layout(set = 0, binding = 2, std430) buffer Out0 { float data[]; } o;

layout(push_constant, std430) uniform Params {
    uint M;
    uint N;
    uint K;
    uint total_out;
    uint batch;
    uint b_batch;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.total_out)
        return;
    uint n = gid % params.N;
    uint m = (gid / params.N) % params.M;
    uint bt = gid / (params.N * params.M);
    const uint bb = params.b_batch == 0u ? params.batch : params.b_batch;
    const uint bt_b = bt % bb;
    float acc = 0.0f;
    for (uint k = 0u; k < params.K; ++k) {
        acc += a.data[bt * params.M * params.K + m * params.K + k] *
               b.data[bt_b * params.K * params.N + k * params.N + n];
    }
    o.data[gid] = acc;
}
