#version 450
// Native Vulkan kernel: Softmax (f32) along an arbitrary axis.
// Input viewed as [outer, len, inner]; one thread per (outer, inner) line,
// numerically stable max-subtraction, then exp and normalized sum.
// binding 0: input, binding 1: output (same shape).
// push constants: lines (= outer*inner), len, inner.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer In0 { float data[]; } in0;
layout(set = 0, binding = 1, std430) buffer Out0 { float data[]; } out0;

layout(push_constant, std430) uniform Params {
    uint lines;
    uint len;
    uint inner;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.lines)
        return;

    const uint o = gid / params.inner;
    const uint t = gid % params.inner;
    const uint base = o * params.len * params.inner + t;

    float m = in0.data[base];
    for (uint i = 1u; i < params.len; ++i)
        m = max(m, in0.data[base + i * params.inner]);

    float s = 0.0f;
    for (uint i = 0u; i < params.len; ++i) {
        const float e = exp(in0.data[base + i * params.inner] - m);
        out0.data[base + i * params.inner] = e;
        s += e;
    }
    for (uint i = 0u; i < params.len; ++i)
        out0.data[base + i * params.inner] /= s;
}
