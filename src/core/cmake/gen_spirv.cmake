# glslangValidator -V <kernel>.comp -> <kernel>.spv, then embed every module
# as a uint32_t array plus a lookup table written into spirv_kernels.inc.
#
# Invoked as: cmake -DGLSLANG=<path> -DSRC=<kernels dir> -DOUT=<gen dir> -P gen_spirv.cmake

set(spirv_files "")
file(GLOB comp_files "${SRC}/*.comp")

foreach(f ${comp_files})
  get_filename_component(name "${f}" NAME_WE)
  set(spv "${OUT}/${name}.spv")
  execute_process(COMMAND "${GLSLANG}" -V "${f}" -o "${spv}"
                  RESULT_VARIABLE rv OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rv EQUAL 0)
    message(FATAL_ERROR "glslangValidator failed for ${f}:\n${err}")
  endif()
  list(APPEND spirv_files "${spv}")
endforeach()

set(inc_lines "// Generated by gen_spirv.cmake. Do not edit.\n")
set(table_lines "")

foreach(spv ${spirv_files})
  get_filename_component(name "${spv}" NAME_WE)
  file(READ "${spv}" hex HEX)
  string(LENGTH "${hex}" hlen)
  math(EXPR nwords "${hlen} / 8")
  set(word_list "")
  set(i 0)
  while(i LESS nwords)
    # Each 8 hex chars are one 32-bit word in file byte order; a SPIR-V
    # uint32 array on a little-endian host must hold the byte-reversed group.
    math(EXPR so "${i} * 8")       # byte0 pair
    math(EXPR so1 "${so} + 2")     # byte1 pair
    math(EXPR so2 "${so} + 4")     # byte2 pair
    math(EXPR so3 "${so} + 6")     # byte3 pair
    string(SUBSTRING "${hex}" ${so} 2 b00)
    string(SUBSTRING "${hex}" ${so1} 2 b01)
    string(SUBSTRING "${hex}" ${so2} 2 b02)
    string(SUBSTRING "${hex}" ${so3} 2 b03)
    set(word_list "${word_list}0x${b03}${b02}${b01}${b00}u,")
    math(EXPR i "${i} + 1")
  endwhile()
  string(APPEND inc_lines "namespace {\n")
  string(APPEND inc_lines "const uint32_t ${name}_spv[] = { ${word_list} };\n")
  string(APPEND inc_lines "}\n")
  string(APPEND table_lines "  {\"${name}\", ${name}_spv, sizeof(${name}_spv) / sizeof(uint32_t)},\n")
endforeach()

file(WRITE "${OUT}/spirv_kernels.inc" "${inc_lines}namespace {\nstruct native_kernel_entry {\n    const char* id;\n    const uint32_t* spirv;\n    uint32_t words;\n};\nconst native_kernel_entry native_kernels_table[] = {\n${table_lines}};\n}\n")