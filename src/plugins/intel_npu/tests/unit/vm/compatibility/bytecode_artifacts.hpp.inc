// clang-format on

enum class TestType : uint8_t { Accurate, ParseSuccess, ParseFailure, RuntimeFailure };

using ScalarValue = std::variant<int64_t, double>;

struct ArtifactMetadata {
    TestType testType;
    std::string entryPointFuncName;
    std::vector<uint8_t> binaryArtifact;
    std::vector<ScalarValue> inputValues;
    std::vector<ScalarValue> expectedValues;

    ArtifactMetadata(TestType testType, std::string entryPointFuncName, std::vector<uint8_t> binaryArtifact,
                     std::vector<ScalarValue> inputValues = {}, std::vector<ScalarValue> expectedValues = {})
            : testType(testType),
              entryPointFuncName(std::move(entryPointFuncName)),
              binaryArtifact(std::move(binaryArtifact)),
              inputValues(std::move(inputValues)),
              expectedValues(std::move(expectedValues)) {
    }
};

template <typename T>
std::vector<ScalarValue> makeScalarValues(std::initializer_list<T> values) {
    std::vector<ScalarValue> result;
    result.reserve(values.size());
    for (const auto value : values) {
        result.emplace_back(value);
    }
    return result;
}

