/*
 * gemm_q80_full.cm -- Dense Q8_0 GEMM, unified layout (v8, cooperative).
 *
 * fp16 activations, SG-transposed Q8_0 weights (pqs_T || pd_T), cm_dpas
 * systolic engine with VNNI-packed fp16-dequantized weight operands.
 *
 * ==========================================================================
 * Q8_0: THE CHEAPEST DECODE AND THE HEAVIEST PAYLOAD
 * ==========================================================================
 * A GGUF Q8_0 block is 32 int8 weights with one fp16 scale:  w = q * d.
 * There is no bit-field extraction at all -- the decode is 8 strided
 * byte->float moves plus 8 multiplies, versus Q4_K's 8 shift+and+mad
 * triples. In exchange the quantized payload per decoded VNNI tile pair is
 * 512 B instead of 256 B, i.e. the ONE thing this kernel makes worse is
 * weight traffic.
 *
 * That trade is why the layout keeps the same 32-weight sub-block / 256-
 * weight K-block structure as every other kernel here instead of switching
 * to a wider tile: the ROW_GROUPS=2 / TOKEN_GROUPS=4 dataflow of
 * gemm_q4k_full.cm is chosen to minimise ACTIVATION traffic per dpas, and
 * Q8_0's extra weight bytes are streamed once per work-group by the
 * cooperative producer, not once per thread. Concretely, at TOKEN_LOCAL=8
 * each 512 B payload load is amortised over 8 consumers x TOKEN_GROUPS dpas
 * pairs, so it costs 512/(8*4) = 16 B per dpas -- an order of magnitude
 * below the 256/ROW_GROUPS bytes of activation per dpas that dominates.
 * Do NOT "fix" Q8_0 by pre-decoding to fp16 in memory: that is the
 * explore_gemm_fp16vnni.cm experiment, measured 0.69-0.93x on Q4_K for
 * exactly the same reason (fp16 weights are bigger than the quantized ones).
 *
 * Byte layout per lane uint32: the four int8 of uint u are K-pos 4u+0..4u+3
 * of the 32-wide sub-block, so u=0..3 fill Blo (K-pos 0..15) and u=4..7 fill
 * Bhi (K-pos 16..31). Within a uint, byte b maps to VNNI (kpair, kbit) =
 * (b>>1, b&1), the SAME strided destination region .select<4,2,16,2>() the
 * Q4_K/Q4_0/Q4_1 decoders use, so the scatter is again a pure register
 * region write with no shuffle.
 * VNNI: B_half[sd][2*n+k_bit] = W_fp16[k=2*sd+k_bit][n]
 *
 * == Weight layout ==  (num_blocks = input_len*output_len/256, OPG=16)
 *   pqs_T: num_blocks * OPG * 256 bytes
 *          [row group][K-block][sub-block j=0..7][uint u=0..7][lane n=0..15][byte b=0..3]
 *          (this is the same shape as moe_gemv_q80_sg.cm's pqs_T)
 *   pd_T:  num_blocks * OPG *  16 bytes
 *          [row group][K-block][sub-block j=0..7][lane n=0..15] fp16 d
 *   weights = pqs_T || pd_T
 *
 * Dispatch: see test_dense_gemm_full.py and gemm_q4k_full.cm.
 *
 * ==========================================================================
 * MEASURED on Arc B580
 * ==========================================================================
 * Baseline = the adopted K-type BMG tile RG=2 TG=4 TL=8 RB=1 SLM_JBLK=4
 * PF_A=1 A_OUTER=0, at token_len=1024:
 *   A_OUTER=1     K4096/N4096 1.23x  K1024/N4096 1.15x
 *                 K12288/N4096 1.12x K4096/N12288 1.39x   <-- ADOPTED
 * On top of A_OUTER=1: TOKEN_GROUPS=2 0.81-1.00x, TOKEN_GROUPS=8
 * 0.18-0.20x (spills), ROW_GROUPS=1 0.70-0.99x, ROW_GROUPS=4/TL=16
 * 0.21-0.25x (spills), TOKEN_LOCAL=16 0.94-1.01x, TOKEN_LOCAL=32/RB=2
 * 0.91-1.04x, PF_A=0 0.95-1.07x.  127 registers, no spill.
 *
 * NOTE the doubled payload does NOT move the optimum: TOKEN_LOCAL=16/32
 * (which would amortise each 512 B payload load over 2-4x more consumers)
 * is neutral-to-worse, confirming the analysis above that the payload is
 * ~16 B/dpas against ~128 B/dpas of activation. Q8_0 lands within a few
 * percent of Q4_0/Q4_1 on every shape measured, which is the expected
 * result for an activation-latency-bound kernel.
 */

#include <cm/cm.h>
#include <cm/cmtl.h>

#pragma OPENCL EXTENSION cl_khr_fp16 : enable

#define OPG 16
#define TOKENS_PER_TILE 8          /* dpas RepeatCount */

#ifdef CM_OUTPUT_F32
typedef float cm_output_t;
#define CM_OUTPUT_BYTES 4
#else
typedef half cm_output_t;
#define CM_OUTPUT_BYTES 2
#endif

#ifndef DECODE_HALF
#define DECODE_HALF 0
#endif
#if DECODE_HALF
typedef half  dect_t;
#else
typedef float dect_t;
#endif

#ifndef COOP_SLM
#define COOP_SLM 1
#endif

#ifndef ROW_GROUPS
#define ROW_GROUPS 2
#endif
#if ROW_GROUPS > 1 && !COOP_SLM
#error "ROW_GROUPS > 1 requires COOP_SLM"
#endif

#ifndef ROW_BLOCKS
#define ROW_BLOCKS 1
#endif
#if ROW_BLOCKS > 1 && !COOP_SLM
#error "ROW_BLOCKS > 1 requires COOP_SLM"
#endif

#ifndef SLM_JBLK
#if ROW_GROUPS > 1
#define SLM_JBLK 4
#else
#define SLM_JBLK 8
#endif
#endif
#ifndef SLM_DEPTH
#define SLM_DEPTH 1
#endif
#ifndef SLM_SLOTS
#define SLM_SLOTS 2
#endif
#ifndef SLM_FULLBAR
#define SLM_FULLBAR 1
#endif

#ifndef TOKEN_GROUPS
#define TOKEN_GROUPS 4
#endif
#ifndef TOKEN_LOCAL
#if COOP_SLM
#define TOKEN_LOCAL 8
#else
#define TOKEN_LOCAL 4
#endif
#endif
#ifndef WALK_HBLK
#define WALK_HBLK 0
#endif
#ifndef PF_W
#if COOP_SLM
#define PF_W 0
#else
#define PF_W 4                     /* Q8_0's payload is 2x Q4_K's: 4x256 B */
#endif
#endif
#ifndef PF_A
#if COOP_SLM && ROW_GROUPS == 1
#define PF_A 0
#else
#define PF_A 1
#endif
#endif
#ifndef A_LOAD_2D
#define A_LOAD_2D 1
#endif
#ifndef MERGE_STORE
#define MERGE_STORE 1
#endif
#ifndef A_OUTER
#define A_OUTER 0
#endif
#ifndef SLM_PAD
#define SLM_PAD 0
#endif
#ifndef A_L1H
#define A_L1H Default
#endif
#ifndef A_L2H
#define A_L2H Default
#endif

#define SLM_NPROD   (SLM_JBLK * ROW_GROUPS * ROW_BLOCKS)
#define TOKEN_SLOTS (TOKEN_LOCAL / ROW_BLOCKS)
#define SLM_TILE_B  ((8 * 32 * 2) + SLM_PAD)
#define SLM_PHASE_B (SLM_NPROD * 2 * SLM_TILE_B)
#define SLM_TOTAL_B (SLM_SLOTS * SLM_PHASE_B)
#define SLM_JPS     (8 / SLM_JBLK)

#define TOKENS_PER_THREAD (TOKENS_PER_TILE * TOKEN_GROUPS)

#if TOKENS_PER_THREAD > 32
#define PFA_ROWS 32
#else
#define PFA_ROWS TOKENS_PER_THREAD
#endif
#define PFA_SETS (TOKENS_PER_THREAD / PFA_ROWS)

/* Decode one 32x16 sub-block into the VNNI tile pair in two SIMD64 passes.
 *
 * `qlo`/`qhi` are the u=0..3 and u=4..7 halves of the sub-block; viewing
 * each as bytes gives [u][lane n][byte b], so the 64 elements at byte offset
 * b, stride 4 are exactly [u=0..3][n=0..15] -- the same (c, n) ordering the
 * Q4_K decoder produces after a shift, and therefore the same destination
 * region .select<4,2,16,2>(b>>1, b&1). No shuffle, no transpose: only a
 * strided byte read, a signed byte->float convert and one multiply.
 *
 * d4 is the per-lane fp16 scale replicated over the 4 u values. */
_GENX_ inline void q80_vnni_decode(
    vector<uint, 4*OPG> qlo, vector<uint, 4*OPG> qhi,
    vector<dect_t, 4*OPG> d4,
    vector_ref<half, 8*32> Blo, vector_ref<half, 8*32> Bhi)
{
    matrix_ref<half, 8, 32> Bl = Blo.format<half, 8, 32>();
    matrix_ref<half, 8, 32> Bh = Bhi.format<half, 8, 32>();

    vector<char, 16*OPG> cl = qlo.format<char>();
    vector<char, 16*OPG> ch = qhi.format<char>();

    { vector<dect_t,4*OPG> w; w = cl.select<4*OPG,4>(0); w=w*d4; Bl.select<4,2,16,2>(0,0)=w.format<dect_t,4,OPG>(); }
    { vector<dect_t,4*OPG> w; w = cl.select<4*OPG,4>(1); w=w*d4; Bl.select<4,2,16,2>(0,1)=w.format<dect_t,4,OPG>(); }
    { vector<dect_t,4*OPG> w; w = cl.select<4*OPG,4>(2); w=w*d4; Bl.select<4,2,16,2>(1,0)=w.format<dect_t,4,OPG>(); }
    { vector<dect_t,4*OPG> w; w = cl.select<4*OPG,4>(3); w=w*d4; Bl.select<4,2,16,2>(1,1)=w.format<dect_t,4,OPG>(); }
    { vector<dect_t,4*OPG> w; w = ch.select<4*OPG,4>(0); w=w*d4; Bh.select<4,2,16,2>(0,0)=w.format<dect_t,4,OPG>(); }
    { vector<dect_t,4*OPG> w; w = ch.select<4*OPG,4>(1); w=w*d4; Bh.select<4,2,16,2>(0,1)=w.format<dect_t,4,OPG>(); }
    { vector<dect_t,4*OPG> w; w = ch.select<4*OPG,4>(2); w=w*d4; Bh.select<4,2,16,2>(1,0)=w.format<dect_t,4,OPG>(); }
    { vector<dect_t,4*OPG> w; w = ch.select<4*OPG,4>(3); w=w*d4; Bh.select<4,2,16,2>(1,1)=w.format<dect_t,4,OPG>(); }
}

extern "C" _GENX_MAIN_ void gemm_q80_full(
    half*  inputs  [[type("svmptr_t")]],   /* [token_len * input_len]  fp16 */
    uchar* weights [[type("svmptr_t")]],   /* pqs_T || pd_T                 */
    cm_output_t* outputs [[type("svmptr_t")]],   /* [token_len * output_len] */
    uint token_len, uint input_len, uint output_len
#ifdef CM_POST_OPS_DECLS
    CM_POST_OPS_DECLS
#endif
)
{
    const uint nbpr       = input_len / 256;
    const uint num_blocks = input_len * output_len / 256;

    uint gh = cm_group_id(0);
    uint gt = cm_group_id(1);
#if WALK_HBLK > 1
    {
        const uint nh = cm_group_count(0);
        const uint nt = cm_group_count(1);
        if ((nh % WALK_HBLK) == 0) {
            const uint lin  = gt * nh + gh;
            const uint band = WALK_HBLK * nt;
            const uint hb   = lin / band;
            const uint rem  = lin - hb * band;
            gt = rem / WALK_HBLK;
            gh = hb * WALK_HBLK + (rem - gt * WALK_HBLK);
        }
    }
#endif
    const uint lid = cm_local_id(1);
    const uint rb = lid % ROW_BLOCKS;
    const uint ts = lid / ROW_BLOCKS;
    const uint h0 = (gh * ROW_BLOCKS + rb) * ROW_GROUPS;
    const uint t = gt * TOKEN_SLOTS + ts;

    const uint tile_base = t * TOKENS_PER_THREAD;
    const uint tok_max   = token_len - 1;

    uchar* pqs_base = weights;
    uchar* pd_base  = weights + num_blocks * 256u;

    vector<float, TOKENS_PER_TILE * OPG> acc[ROW_GROUPS * TOKEN_GROUPS];
    #pragma unroll
    for (int i = 0; i < ROW_GROUPS * TOKEN_GROUPS; i++) acc[i] = 0.0f;

#if PF_A
    lsc::block_2d_desc<half, 1, PFA_ROWS, 32> pfA(
        inputs, token_len - 1, input_len * (uint)sizeof(half) - 1,
        input_len * (uint)sizeof(half) - 1, 0, (int)tile_base);
#endif
#if A_LOAD_2D
    lsc::block_2d_desc<half, 2, TOKENS_PER_TILE, 16> b2dA(
        inputs, token_len - 1, input_len * (uint)sizeof(half) - 1,
        input_len * (uint)sizeof(half) - 1, 0, 0);
#endif

#if COOP_SLM
    cm_slm_init(SLM_TOTAL_B);
    uint slm = cm_slm_alloc(SLM_TOTAL_B);

    const uint nstages = nbpr * SLM_JPS;

    auto stage_fn = [&](int s) {
        if (s >= (int)nstages) return;
        const uint sbase = ((uint)s & (SLM_SLOTS - 1)) * SLM_PHASE_B;
        const uint kb    = (uint)s / SLM_JPS;
        const uint jb    = (uint)s - kb * SLM_JPS;

#if SLM_NPROD >= TOKEN_LOCAL
        #pragma unroll
        for (int u = 0; u < SLM_NPROD / TOKEN_LOCAL; u++) {
            const uint w = lid + (uint)u * TOKEN_LOCAL;
#else
        if (lid < SLM_NPROD) {
            const uint w = lid;
#endif
            const uint rgj = ROW_GROUPS * SLM_JBLK;
            const uint rbp = w / rgj;
            const uint rem = w - rbp * rgj;
            const uint rg = rem / SLM_JBLK;
            const uint jl = rem - rg * SLM_JBLK;
            const uint blk = ((gh * ROW_BLOCKS + rbp) * ROW_GROUPS + rg) * nbpr + kb;
            const uint j  = jb * SLM_JBLK + jl;

            const uint pqs_byte = blk * (OPG * 256u) + j * 512u;
#if PF_W
            if (s + 1 < (int)nstages)
                #pragma unroll
                for (int p = 0; p < 2; p++)
                    cm_ptr_prefetch<64, DataSize::U32, CacheHint::Cached, CacheHint::Cached>(
                        (const unsigned*)pqs_base, pqs_byte + SLM_JBLK * 512u + p * 256u);
#endif
            /* 512 B payload = two SIMD64 uint loads (lo half = K-pos 0..15,
             * hi half = K-pos 16..31 of the sub-block) */
            vector<uint, 4*OPG> qlo =
                cm_ptr_load<uint, 4*OPG>((uint*)pqs_base, pqs_byte);
            vector<uint, 4*OPG> qhi =
                cm_ptr_load<uint, 4*OPG>((uint*)pqs_base, pqs_byte + 256u);

            vector<uint, OPG/2> pd_u =
                cm_ptr_load<uint, OPG/2>((uint*)pd_base, blk * (OPG * 16u) + j * 32u);
            vector<half,  OPG> dh = pd_u.format<half>();
            vector<float, OPG> dF; dF = dh;

            vector<dect_t, 4*OPG> d4;
            #pragma unroll
            for (int c = 0; c < 4; c++) d4.select<OPG,1>(c*OPG) = dF;

            vector<half, 8*32> Blo, Bhi;
            q80_vnni_decode(qlo, qhi, d4, Blo, Bhi);
            cm_slm_block_write(slm, (int)(sbase + (w * 2 + 0) * SLM_TILE_B), Blo);
            cm_slm_block_write(slm, (int)(sbase + (w * 2 + 1) * SLM_TILE_B), Bhi);
        }
    };

    #pragma unroll
    for (int d = 0; d < SLM_DEPTH; d++) stage_fn(d);
#if !SLM_FULLBAR
    cm_slm_fence(CM_LOCAL_BARRIER);
    cm_sbarrier(1);
#endif

    for (uint s = 0; s < nstages; s++) {
#if SLM_FULLBAR
        cm_slm_fence(CM_LOCAL_BARRIER);
        cm_barrier();
#else
        cm_fence(CM_LOCAL_BARRIER);
        cm_sbarrier(0);
        if (s + 1 < nstages) cm_sbarrier(1);
#endif

        stage_fn((int)s + SLM_DEPTH);

        const uint kb = s / SLM_JPS;
        const uint jb = s - kb * SLM_JPS;
#if PF_A
        if (jb == 0 && kb + 1 < nbpr) {
            #pragma unroll
            for (int r = 0; r < PFA_SETS; r++) {
                pfA.set_block_y((int)(tile_base + r * PFA_ROWS));
                #pragma unroll
                for (int p = 0; p < PF_A; p++)
                    cm_prefetch<CacheHint::Cached, CacheHint::Cached>(
                        pfA.set_block_x((int)((kb + 1) * 256u) + p * 32));
            }
        }
#endif
        const uint sbase = (s & (SLM_SLOTS - 1)) * SLM_PHASE_B;

#if A_OUTER
        #pragma unroll
        for (int jl = 0; jl < SLM_JBLK; jl++) {
            const int j = (int)jb * SLM_JBLK + jl;
            vector<half, 2 * TOKENS_PER_TILE * 16> A2[TOKEN_GROUPS];
            #pragma unroll
            for (int tg = 0; tg < TOKEN_GROUPS; tg++) {
                b2dA.set_block_y((int)(tile_base + tg * TOKENS_PER_TILE));
                cm_load<lsc::Normal, CacheHint::A_L1H, CacheHint::A_L2H>(
                    A2[tg], b2dA.set_block_x((int)(kb * 256u) + j * 32));
            }
            #pragma unroll
            for (int rg = 0; rg < ROW_GROUPS; rg++) {
                const uint ti = (rb * ROW_GROUPS + (uint)rg) * SLM_JBLK + (uint)jl;
                vector<half, 8*32> Blo, Bhi;
                cm_slm_block_read(slm, GENX_NONE,
                    (int)(sbase + (ti * 2 + 0) * SLM_TILE_B), Blo);
                cm_slm_block_read(slm, GENX_NONE,
                    (int)(sbase + (ti * 2 + 1) * SLM_TILE_B), Bhi);
                #pragma unroll
                for (int tg = 0; tg < TOKEN_GROUPS; tg++) {
                    auto Alo = A2[tg].select<TOKENS_PER_TILE * 16, 1>(0);
                    auto Ahi = A2[tg].select<TOKENS_PER_TILE * 16, 1>(TOKENS_PER_TILE * 16);
                    acc[rg * TOKEN_GROUPS + tg] =
                        cm_dpas<CM_PRECISION_HF,CM_PRECISION_HF,8,TOKENS_PER_TILE>(
                            acc[rg * TOKEN_GROUPS + tg], Blo.format<int32_t>(), Alo.format<int32_t>());
                    acc[rg * TOKEN_GROUPS + tg] =
                        cm_dpas<CM_PRECISION_HF,CM_PRECISION_HF,8,TOKENS_PER_TILE>(
                            acc[rg * TOKEN_GROUPS + tg], Bhi.format<int32_t>(), Ahi.format<int32_t>());
                }
            }
        }
#else
        #pragma unroll
        for (int jl = 0; jl < SLM_JBLK; jl++) {
            vector<half, 8*32> Blo[ROW_GROUPS], Bhi[ROW_GROUPS];
            #pragma unroll
            for (int rg = 0; rg < ROW_GROUPS; rg++) {
                const uint ti = (rb * ROW_GROUPS + (uint)rg) * SLM_JBLK + (uint)jl;
                cm_slm_block_read(slm, GENX_NONE,
                    (int)(sbase + (ti * 2 + 0) * SLM_TILE_B), Blo[rg]);
                cm_slm_block_read(slm, GENX_NONE,
                    (int)(sbase + (ti * 2 + 1) * SLM_TILE_B), Bhi[rg]);
            }

            const int j = (int)jb * SLM_JBLK + jl;
            #pragma unroll
            for (int tg = 0; tg < TOKEN_GROUPS; tg++) {
                vector<half, 2 * TOKENS_PER_TILE * 16> A2;
                b2dA.set_block_y((int)(tile_base + tg * TOKENS_PER_TILE));
                cm_load<lsc::Normal, CacheHint::A_L1H, CacheHint::A_L2H>(
                    A2, b2dA.set_block_x((int)(kb * 256u) + j * 32));
                auto Alo = A2.select<TOKENS_PER_TILE * 16, 1>(0);
                auto Ahi = A2.select<TOKENS_PER_TILE * 16, 1>(TOKENS_PER_TILE * 16);
                #pragma unroll
                for (int rg = 0; rg < ROW_GROUPS; rg++) {
                    acc[rg * TOKEN_GROUPS + tg] =
                        cm_dpas<CM_PRECISION_HF,CM_PRECISION_HF,8,TOKENS_PER_TILE>(
                            acc[rg * TOKEN_GROUPS + tg], Blo[rg].format<int32_t>(), Alo.format<int32_t>());
                    acc[rg * TOKEN_GROUPS + tg] =
                        cm_dpas<CM_PRECISION_HF,CM_PRECISION_HF,8,TOKENS_PER_TILE>(
                            acc[rg * TOKEN_GROUPS + tg], Bhi[rg].format<int32_t>(), Ahi.format<int32_t>());
                }
            }
        }
#endif /* A_OUTER */
    }
#else  /* !COOP_SLM */

    for (uint kb = 0; kb < nbpr; kb++) {
        const uint blk = h0 * nbpr + kb;
#if PF_W
        if (kb + 1 < nbpr) {
            #pragma unroll
            for (int p = 0; p < PF_W; p++)
                cm_ptr_prefetch<64, DataSize::U32, CacheHint::Cached, CacheHint::Cached>(
                    (const unsigned*)pqs_base, (blk + 1) * (OPG * 256u) + p * 256u);
            cm_ptr_prefetch<64, DataSize::U32, CacheHint::Cached, CacheHint::Cached>(
                (const unsigned*)pd_base, (blk + 1) * (OPG * 16u));
        }
#endif
#if PF_A
        if (kb + 1 < nbpr) {
            #pragma unroll
            for (int r = 0; r < PFA_SETS; r++) {
                pfA.set_block_y((int)(tile_base + r * PFA_ROWS));
                #pragma unroll
                for (int p = 0; p < PF_A; p++)
                    cm_prefetch<CacheHint::Cached, CacheHint::Cached>(
                        pfA.set_block_x((int)((kb + 1) * 256u) + p * 32));
            }
        }
#endif
        const uint pqs_byte = blk * (OPG * 256u);
        const uint pd_byte  = blk * (OPG * 16u);
        const uint a_koff   = kb * 256u * (uint)sizeof(half);

        #pragma unroll
        for (int j = 0; j < 8; j++) {
            vector<uint, 4*OPG> qlo =
                cm_ptr_load<uint, 4*OPG>((uint*)pqs_base, pqs_byte + j*512);
            vector<uint, 4*OPG> qhi =
                cm_ptr_load<uint, 4*OPG>((uint*)pqs_base, pqs_byte + j*512 + 256);
            vector<uint, OPG/2> pd_u =
                cm_ptr_load<uint, OPG/2>((uint*)pd_base, pd_byte + j*32);
            vector<half,  OPG> dh = pd_u.format<half>();
            vector<float, OPG> dF; dF = dh;

            vector<dect_t, 4*OPG> d4;
            #pragma unroll
            for (int c = 0; c < 4; c++) d4.select<OPG,1>(c*OPG) = dF;

            vector<half, 8*32> Blo, Bhi;
            q80_vnni_decode(qlo, qhi, d4, Blo, Bhi);

            #pragma unroll
            for (int tg = 0; tg < TOKEN_GROUPS; tg++) {
#if A_LOAD_2D
                vector<half, 2 * TOKENS_PER_TILE * 16> A2;
                b2dA.set_block_y((int)(tile_base + tg * TOKENS_PER_TILE));
                cm_load<lsc::Normal>(A2, b2dA.set_block_x((int)(kb * 256u) + j * 32));
                auto Alo = A2.select<TOKENS_PER_TILE * 16, 1>(0);
                auto Ahi = A2.select<TOKENS_PER_TILE * 16, 1>(TOKENS_PER_TILE * 16);
#else
                vector<half, TOKENS_PER_TILE * 16> Alo, Ahi;
                #pragma unroll
                for (int i = 0; i < TOKENS_PER_TILE; i++) {
                    uint tok = tile_base + tg * TOKENS_PER_TILE + i;
                    tok = (tok < token_len) ? tok : tok_max;
                    const uint ab = tok * input_len * (uint)sizeof(half) + a_koff + j * 64u;
                    vector<half, 32> ah =
                        cm_ptr_load<uint, 16>((uint*)inputs, ab).format<half>();
                    Alo.select<16,1>(i*16) = ah.select<16,1>(0);
                    Ahi.select<16,1>(i*16) = ah.select<16,1>(16);
                }
#endif
                acc[tg] = cm_dpas<CM_PRECISION_HF,CM_PRECISION_HF,8,TOKENS_PER_TILE>(
                              acc[tg], Blo.format<int32_t>(), Alo.format<int32_t>());
                acc[tg] = cm_dpas<CM_PRECISION_HF,CM_PRECISION_HF,8,TOKENS_PER_TILE>(
                              acc[tg], Bhi.format<int32_t>(), Ahi.format<int32_t>());
            }
        }
    }
#endif /* COOP_SLM */

#if MERGE_STORE
    #pragma unroll
    for (int tg = 0; tg < TOKEN_GROUPS; tg++) {
        #pragma unroll
        for (int i = 0; i < TOKENS_PER_TILE; i++) {
            uint tok = tile_base + tg * TOKENS_PER_TILE + i;
            if (tok < token_len) {
                vector<float, ROW_GROUPS * OPG> ov;
                #pragma unroll
                for (int rg = 0; rg < ROW_GROUPS; rg++)
                    ov.select<OPG, 1>(rg * OPG) =
                        acc[rg * TOKEN_GROUPS + tg].select<OPG, 1>(i * OPG);
#if CM_POST_OPS_NUM > 0
                /* Vectorized post-ops: mutate the WHOLE 'ov' vector in a
                 * couple of SIMD instructions -- never a per-lane scalar
                 * loop (that regressed perf badly: unrolled over
                 * ROW_GROUPS*OPG lanes x up to TOKEN_GROUPS*TOKENS_PER_TILE
                 * token stores = hundreds of scalar ops, plus non-coalesced
                 * scalar loads of the fused operand). */
                { const uint _po_base = tok * output_len + h0 * OPG;
                  #ifdef CM_APPLY_POST_OP_0
                  CM_APPLY_POST_OP_0(ov, _po_base, ROW_GROUPS * OPG)
                  #endif
                  #ifdef CM_APPLY_POST_OP_1
                  CM_APPLY_POST_OP_1(ov, _po_base, ROW_GROUPS * OPG)
                  #endif
                  #ifdef CM_APPLY_POST_OP_2
                  CM_APPLY_POST_OP_2(ov, _po_base, ROW_GROUPS * OPG)
                  #endif
                }
#endif
                vector<cm_output_t, ROW_GROUPS * OPG> ov_h = ov;
#ifdef CM_OUTPUT_F32
                cm_ptr_store<float, ROW_GROUPS * OPG>((float*)outputs,
                    (tok * output_len + h0 * OPG) * (uint)sizeof(float), ov_h);
#else
                cm_ptr_store<uint, ROW_GROUPS * OPG / 2>((uint*)outputs,
                    (tok * output_len + h0 * OPG) * (uint)sizeof(half), ov_h.format<uint>());
#endif
            }
        }
    }
#else
    #pragma unroll
    for (int rg = 0; rg < ROW_GROUPS; rg++) {
        #pragma unroll
        for (int tg = 0; tg < TOKEN_GROUPS; tg++) {
            #pragma unroll
            for (int i = 0; i < TOKENS_PER_TILE; i++) {
                uint tok = tile_base + tg * TOKENS_PER_TILE + i;
                if (tok < token_len) {
                    vector<float, OPG> ov_rg = acc[rg * TOKEN_GROUPS + tg].select<OPG, 1>(i * OPG);
#if CM_POST_OPS_NUM > 0
                    { const uint _po_base = tok * output_len + (h0 + (uint)rg) * OPG;
                      #ifdef CM_APPLY_POST_OP_0
                      CM_APPLY_POST_OP_0(ov_rg, _po_base, OPG)
                      #endif
                      #ifdef CM_APPLY_POST_OP_1
                      CM_APPLY_POST_OP_1(ov_rg, _po_base, OPG)
                      #endif
                      #ifdef CM_APPLY_POST_OP_2
                      CM_APPLY_POST_OP_2(ov_rg, _po_base, OPG)
                      #endif
                    }
#endif
                    { vector<cm_output_t, OPG> ov_out = ov_rg;
#ifdef CM_OUTPUT_F32
                      cm_ptr_store<float, OPG>((float*)outputs,
                          (tok * output_len + (h0 + rg) * OPG) * (uint)sizeof(float), ov_out); }
#else
                      cm_ptr_store<uint, OPG / 2>((uint*)outputs,
                          (tok * output_len + (h0 + rg) * OPG) * (uint)sizeof(half), ov_out.format<uint>()); }
#endif
                }
            }
        }
    }
#endif
}
