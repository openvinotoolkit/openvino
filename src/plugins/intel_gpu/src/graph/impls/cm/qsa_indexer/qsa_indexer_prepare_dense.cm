// Q1 - QSAIndexer (non-paged, functional state) prepare.
//
// Same math as qsa_indexer_prepare_paged.cm (RMSNorm/partial RoPE/mean pooling), with
// DIRECT dense addressing: no page table is read or synthesized. `batch` IS the sequence
// axis. Row-major `q_idx`/`k_idx`/`indexer_q` of shape [B, L, H, Di] are addressed via
// the flat token index `t = b * seq_len + l`, which is exactly that tensor's own row order.
//
// Per batch row: KL = key_length[b], n_new = min(L, KL), pad = L - n_new (left padding),
// S0 = KL - n_new (valid tokens before the call). The real token of logical position p
// (S0 <= p < KL) is row `pad + p - S0`. Padding rows are never read.
//
// State: the old incomplete block's raw keys (slot p % r) and its first-token RoPE row are
// read from the INPUT state (`raw_in`/`rope_in`); new summaries, the new incomplete block's
// keys and RoPE row are written to the OUTPUT state buffers. The host copies every state
// input into its output before this kernel runs, so untouched entries carry over.
// Input and output state are distinct buffers, so there is no read-before-write hazard.
//
// RoPE never derives an angle from a position: a query is rotated with its own full-width
// `rope_cos`/`rope_sin` row and a block summary with the row of the block's first logical
// token (the input row if it belongs to this call, otherwise `rope_in`). A RoPE state row
// interleaves (cos_j, sin_j), 2 * rotary_dim values.
//
// JIT constants: QSA_IDX_QUERY_HEADS, QSA_IDX_HEAD_DIM, QSA_IDX_ROTARY_DIM,
// QSA_COMPRESS_RATIO, QSA_IDX_NORM_EPS, QSA_PREPARE_WG
//
// Dispatch: gws = [1, 1, num_wg * QSA_PREPARE_WG], lws = [1, 1, QSA_PREPARE_WG]

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_ops_common.hpp"

extern "C" _GENX_MAIN_ void KERNEL_NAME(const half* q_idx ATTR,                  // [B, L, Hiq, Di] row-major == [tokens, Hiq*Di]
                                        const half* k_idx ATTR,                  // [B, L, 1, Di] row-major == [tokens, Di]
                                        const half* q_norm_weight ATTR,          // [Di]
                                        const half* k_norm_weight ATTR,          // [Di]
                                        const half* rope_cos ATTR,               // [B, L, rotary_dim] == [tokens, rotary_dim]
                                        const half* rope_sin ATTR,               // [B, L, rotary_dim] == [tokens, rotary_dim]
                                        const int32_t* key_length ATTR,          // [B]
                                        const half* raw_in ATTR,                 // [B, 1, r-1, Di], input state
                                        const half* rope_in ATTR,                // [B, 2*rotary_dim], input state
                                        half* summary_cache ATTR,                // [B, 1, floor(S_cap/r), Di], output state
                                        half* raw_out ATTR,                      // [B, 1, r-1, Di], output state
                                        half* rope_out ATTR,                     // [B, 2*rotary_dim], output state
                                        half* indexer_q ATTR,                    // [tokens, Hiq, Di]
                                        uint32_t num_wg,                         // B * blocks_per_row
                                        uint32_t blocks_per_row,                 // upper bound of blocks one row touches
                                        uint32_t seq_len,
                                        uint32_t summary_stride) {
    constexpr uint HIQ = QSA_IDX_QUERY_HEADS;
    constexpr uint DI = QSA_IDX_HEAD_DIM;
    constexpr uint ROT = QSA_IDX_ROTARY_DIM;
    constexpr uint R = QSA_COMPRESS_RATIO;
    constexpr uint WG = QSA_PREPARE_WG;

    static_assert(DI % 16 == 0, "indexer head dim must be a multiple of 16");
    static_assert(HIQ + 1 <= WG, "one thread per index-query head plus one for the index key");

    const uint wg = cm_group_id(2);
    if (wg >= num_wg) {
        return;
    }
    const uint tid = cm_local_id(2);

    // key_length lives in GPU memory, so the host cannot know which blocks a row touches: work-group
    // `slot` of row `batch` takes block past/r + slot and exits when that block holds no new token.
    const uint batch = wg / blocks_per_row;
    const uint total_len = (uint)key_length[batch];
    const uint n_new = total_len < seq_len ? total_len : seq_len;
    const uint past_len = total_len - n_new;
    const uint qsa_block = past_len / R + wg % blocks_per_row;
    if (qsa_block * R >= total_len) {
        return;
    }

    constexpr uint SLM_RAWK_SIZE = R * DI * (uint)sizeof(float);
    constexpr uint SLM_POOL_SIZE = DI * (uint)sizeof(float);
    cm_slm_init(SLM_RAWK_SIZE + SLM_POOL_SIZE);
    auto slm_rawk = cm_slm_alloc(SLM_RAWK_SIZE);
    auto slm_pool = cm_slm_alloc(SLM_POOL_SIZE);

    // Flat token index of logical position `past_len` (the first real row of this call).
    const uint seq_begin = batch * seq_len + (seq_len - n_new);

    const uint block_start = qsa_block * R;
    const uint block_end = block_start + R;
    const bool block_completes = block_end <= total_len;
    const uint lo = block_start > past_len ? block_start : past_len;
    const uint hi = block_end < total_len ? block_end : total_len;

    for (uint p = lo; p < hi; p++) {
        const uint token_idx = seq_begin + (p - past_len);

        if (tid < HIQ) {
            vector<half, DI> q_h;
            qsa_gr::load_hv<DI>(q_h, q_idx, (token_idx * HIQ + tid) * DI);
            vector<float, DI> q = q_h;
            qsa::rms_norm<DI>(q, q_norm_weight, (float)QSA_IDX_NORM_EPS);
#if QSA_IDX_ROTARY_DIM > 0
            vector<float, ROT> c = qsa::load_half_row<ROT>(rope_cos, token_idx * ROT);
            vector<float, ROT> s = qsa::load_half_row<ROT>(rope_sin, token_idx * ROT);
            qsa::apply_partial_rope<DI, ROT>(q, c, s);
#endif
            vector<half, DI> q_out = q;
            qsa_gr::store_hv<DI>(indexer_q, (token_idx * HIQ + tid) * DI, q_out);
        } else if (tid == HIQ) {
            vector<half, DI> k_h;
            qsa_gr::load_hv<DI>(k_h, k_idx, token_idx * DI);

            if (!block_completes) {
                // Staged key of the new incomplete block, slot p % r.
                qsa_gr::store_hv<DI>(raw_out, (batch * (R - 1) + (p - block_start)) * DI, k_h);
#if QSA_IDX_ROTARY_DIM > 0
                if (p == block_start) {
                    vector<half, 2 * ROT> row;
                    row.select<ROT, 2>(0) = qsa::load_half_row<ROT>(rope_cos, token_idx * ROT);
                    row.select<ROT, 2>(1) = qsa::load_half_row<ROT>(rope_sin, token_idx * ROT);
                    qsa::store_half_row<2 * ROT>(rope_out, batch * 2 * ROT, row);
                }
#endif
            }

            vector<float, DI> kv = k_h;
            cm_slm_block_write(slm_rawk, ((p - block_start) * DI) * (uint)sizeof(float), kv);
        }
        cm_fence(CM_LOCAL_BARRIER);
        cm_barrier();
    }

    if (!block_completes) {
        return;
    }

    for (uint d0 = tid * 16; d0 < DI; d0 += WG * 16) {
        vector<float, 16> acc = 0.0f;
        for (uint s = 0; s < R; s++) {
            const uint p = block_start + s;
            if (p >= past_len) {
                vector<float, 16> v;
                cm_slm_block_read(slm_rawk, (s * DI + d0) * (uint)sizeof(float), v);
                acc += v;
            } else {
                // Staged by an earlier call; slot r-1 is never staged (it completes the block).
                vector<float, 16> v = qsa_gr::load_h16(raw_in, (batch * (R - 1) + s) * DI + d0);
                acc += v;
            }
        }
        acc = acc * (1.0f / (float)R);
        cm_slm_block_write(slm_pool, d0 * (uint)sizeof(float), acc);
    }
    cm_fence(CM_LOCAL_BARRIER);
    cm_barrier();

    if (tid == 0) {
        vector<float, DI> pooled;
        cm_slm_block_read(slm_pool, 0, pooled);
        // The pooled mean is rounded to T before RMSNorm, like the reference model.
        vector<half, DI> pooled_h = pooled;
        pooled = pooled_h;
        qsa::rms_norm<DI>(pooled, k_norm_weight, (float)QSA_IDX_NORM_EPS);
#if QSA_IDX_ROTARY_DIM > 0
        // Coefficients of the block's first token: its input row when THIS call appended it,
        // otherwise the row an earlier call kept in the RoPE state.
        vector<float, ROT> c, s;
        if (block_start >= past_len) {
            const uint first_token = seq_begin + (block_start - past_len);
            c = qsa::load_half_row<ROT>(rope_cos, first_token * ROT);
            s = qsa::load_half_row<ROT>(rope_sin, first_token * ROT);
        } else {
            vector<float, 2 * ROT> row = qsa::load_half_row<2 * ROT>(rope_in, batch * 2 * ROT);
            c = row.select<ROT, 2>(0);
            s = row.select<ROT, 2>(1);
        }
        qsa::apply_partial_rope<DI, ROT>(pooled, c, s);
#endif

        const uint dst = qsa_ops::offset_dense(batch, qsa_block, summary_stride, DI);
        vector<half, DI> summary_out = pooled;
        qsa_gr::store_hv<DI>(summary_cache, dst, summary_out);
    }
}
