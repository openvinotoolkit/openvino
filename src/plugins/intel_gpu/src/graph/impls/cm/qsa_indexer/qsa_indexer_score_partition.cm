// Q2 score, decode-partition variant - shared by PagedQSAIndexer / QSAIndexer.
//
// Ported from the proven qsa_score_partition.cm: decode has exactly one query token per
// sequence, so a per-token scorer dispatches only
// num_tokens work-items - at batch sizes typical of serving, that is a severe GPU
// under-occupancy regression relative to prefill. This kernel instead partitions the
// BLOCK RANGE visible to each token across QSA_SCORE_PARTITIONS independent work-items
// (partitioning along the index-query-head dimension is NOT valid: ReLU precedes the
// head reduction in qsa_block_score, so a per-head split would re-read every summary
// once per head). Scoring math matches qsa_indexer_score_topk_fused.cm exactly (same per-head ReLU
// dot product, scaled by 1/sqrt(Di)); only the block range iterated differs.
//
// QSA_ADDRESS_MODE selects the summary-cache address helper only (paged page-table
// gather vs. dense direct batch/stride addressing); the scoring math is identical.
//
// JIT constants: QSA_IDX_QUERY_HEADS, QSA_IDX_HEAD_DIM, QSA_IDX_SCALE, QSA_COMPRESS_RATIO,
// QSA_ADDRESS_MODE, QSA_BLOCK_TOPK, QSA_SCORE_PARTITION_BLOCKS, and (paged only)
// QSA_PAGE_SIZE
//
// Dispatch: gws = [row_end - row_begin, 1, num_partitions], lws = [1, 1, 1].
// block_scores holds only rows [row_begin, row_end) (bounded-scratch chunking).

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_ops_common.hpp"

extern "C" _GENX_MAIN_ void KERNEL_NAME(const half* indexer_q ATTR,              // [tokens, Hiq, Di]
                                        const half* summary_cache ATTR,          // paged: [N_phys,1,page/r,Di]; dense: [B,1,S_cap/r,Di]
                                        const int32_t* past_lens ATTR,           // paged: [num_seqs]; dense: [B]
#if QSA_ADDRESS_MODE == 0
                                        const int32_t* subsequence_begins ATTR,  // [num_seqs+1]
                                        const int32_t* block_indices ATTR,       // [used_blocks]
                                        const int32_t* block_indices_begins ATTR,  // [num_seqs+1]
#endif
                                        float* block_scores ATTR,                  // [row_end - row_begin, max_blocks]
                                        uint32_t num_tokens,
#if QSA_ADDRESS_MODE == 0
                                        uint32_t num_seqs,
#else
                                        uint32_t seq_len,
                                        uint32_t summary_stride,
#endif
                                        uint32_t max_blocks,
                                        uint32_t num_partitions,
                                        uint32_t row_begin,
                                        uint32_t row_end) {
    constexpr uint HIQ = QSA_IDX_QUERY_HEADS;
    constexpr uint DI = QSA_IDX_HEAD_DIM;
#if QSA_ADDRESS_MODE == 0
    constexpr uint PAGE = QSA_PAGE_SIZE;
    constexpr uint R = QSA_COMPRESS_RATIO;
    constexpr uint SUMMARIES_PER_PAGE = PAGE / R;
#endif

    const uint token_idx = cm_global_id(0) + row_begin;
    const uint partition = cm_global_id(2);
    if (token_idx >= row_end || token_idx >= num_tokens || partition >= num_partitions) {
        return;
    }

    uint seq = 0, abs_pos = 0;
#if QSA_ADDRESS_MODE == 0
    qsa_ops::resolve_token_paged(subsequence_begins, past_lens, num_seqs, token_idx, seq, abs_pos);
    const uint page_begin = (uint)block_indices_begins[seq];
#else
    qsa_ops::resolve_token_dense(past_lens, seq_len, token_idx, seq, abs_pos);
#endif

    const uint n_complete = qsa_ops::num_complete_blocks(abs_pos);
#if QSA_DENSE_SCORE_BYPASS
    // Explicit pipeline opt-in only; the paired finalizer must bypass score reads.
    if (n_complete <= (uint)QSA_BLOCK_TOPK) {
        return;
    }
#endif

    const uint begin = partition * (uint)QSA_SCORE_PARTITION_BLOCKS;
    if (begin >= n_complete) {
        return;
    }
    uint end = begin + (uint)QSA_SCORE_PARTITION_BLOCKS;
    if (end > n_complete) {
        end = n_complete;
    }

    const uint row = (token_idx - row_begin) * max_blocks;

    // Query stays in registers for the whole partition scan; only summaries stream.
    matrix<half, HIQ, DI> q;
#pragma unroll
    for (uint h = 0; h < HIQ; h++) {
        qsa_gr::load_hv<DI>(q.row(h), indexer_q, (token_idx * HIQ + h) * DI);
    }

    for (uint b = begin; b < end; b++) {
#if QSA_ADDRESS_MODE == 0
        const uint page = (uint)block_indices[page_begin + b / SUMMARIES_PER_PAGE];
        const uint src = qsa::summary_offset(page, b % SUMMARIES_PER_PAGE, SUMMARIES_PER_PAGE, DI);
#else
        const uint src = qsa_ops::offset_dense(seq, b, summary_stride, DI);
#endif
        vector<half, DI> summary;
        qsa_gr::load_hv<DI>(summary, summary_cache, src);

        float total = 0.0f;
#pragma unroll
        for (uint h = 0; h < HIQ; h++) {
            float dot = 0.0f;
#pragma unroll
            for (uint k = 0; k < DI; k += 16) {
                vector<float, 16> qv = q.row(h).template select<16, 1>(k);
                vector<float, 16> kv = summary.template select<16, 1>(k);
                dot += cm_sum<float>(qv * kv);
            }
            total += dot > 0.0f ? dot : 0.0f;
        }
        block_scores[row + b] = total * (float)QSA_IDX_SCALE;
    }
}
