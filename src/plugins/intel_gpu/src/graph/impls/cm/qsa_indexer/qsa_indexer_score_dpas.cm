// Q2 prefill, systolic variant - shared by PagedQSAIndexer / QSAIndexer.
//
// Ported from the proven qsa_score_tile_dpas.cm: same maths as qsa_indexer_score_topk_fused.cm (which
// stays the non-dpas fallback), but the (query x block) score matrix is produced
// by cm_dpas instead of per-lane dot products. This kernel only SCORES; selection is left
// to qsa_indexer_topk.cm, which both this kernel and the scalar one feed identically.
//
// Tile mapping (identical to qsa_score_tile_dpas.cm):
//   N (fixed to the GRF width, 16) = QUERY tile     -> prefill always has enough queries
//   M (RepeatCount, 8)             = QSA block tile
//   K (16 halfs per dpas)          = indexer head dim, accumulated over Di/16 steps
// dst[block][query], exactly like ugemm_KQ's St[kv][q] in the PA kernels.
//
// QSA_ADDRESS_MODE only changes how a work-group's A operand (QSA_REG_M consecutive block
// summaries) is fetched:
//   0 (paged): summaries for one QSA block tile may straddle a page boundary, so the tile
//      is assembled from whole pages exactly like qsa_score_tile_dpas.cm (QSA_PAGE_SIZE /
//      QSA_COMPRESS_RATIO summaries per page, gathered through block_indices).
//   1 (dense): there is no page table at all - one batch row's summaries are one
//      contiguous `[S_cap/r, Di]` region (runtime `summary_stride` elements per row), so
//      QSA_REG_M consecutive summaries are ALWAYS one plain 2D block load, with no
//      sub-tile splitting.
// The query-staging, QK dpas reduction, ReLU-per-head, transpose and dense-bypass skip
// are identical in both modes.
//
// JIT constants: QSA_IDX_QUERY_HEADS, QSA_IDX_HEAD_DIM, QSA_IDX_SCALE, QSA_COMPRESS_RATIO,
// QSA_BLOCK_TOPK, QSA_ADDRESS_MODE, QSA_SCORE_WG, and (paged only) QSA_PAGE_SIZE.
//
// Dispatch: gws = [num_tiles * QSA_SCORE_WG, 1, 1], lws = [QSA_SCORE_WG, 1, 1]
// One work-group owns one 16-query tile. num_tiles is a shape-derived upper bound; paged mode
// finds the tile's sequence from subsequence_begins on the GPU, dense mode from the tile index.

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_dpas_common.hpp"
#include "qsa_ops_common.hpp"

#define QSA_SCORE_KTILES (QSA_IDX_HEAD_DIM / QSA_REG_K)
#define QSA_SCORE_QT_TILES (QSA_IDX_QUERY_HEADS * QSA_SCORE_KTILES)

extern "C" _GENX_MAIN_ void KERNEL_NAME(const half* indexer_q ATTR,             // [tokens, Hiq, Di]
                                        const half* summary_cache ATTR,         // paged: [N_phys,1,page/r,Di]; dense: [B,1,S_cap/r,Di]
                                        const int32_t* past_lens ATTR,          // paged: [num_seqs]; dense: [B]
#if QSA_ADDRESS_MODE == 0
                                        const int32_t* subsequence_begins ATTR,  // [num_seqs+1]
                                        const int32_t* block_indices ATTR,       // [used_blocks]
                                        const int32_t* block_indices_begins ATTR,  // [num_seqs+1]
#endif
                                        float* block_scores ATTR,                  // [tokens, max_blocks]
                                        uint32_t num_tiles,
#if QSA_ADDRESS_MODE == 0
                                        uint32_t num_seqs,
#else
                                        uint32_t seq_len,
                                        uint32_t summary_stride,
#endif
                                        uint32_t max_blocks) {
    constexpr uint HIQ = QSA_IDX_QUERY_HEADS;
    constexpr uint DI = QSA_IDX_HEAD_DIM;
    constexpr uint WG = QSA_SCORE_WG;
    constexpr uint NQ = QSA_REG_N;
    constexpr uint MB = QSA_REG_M;
    constexpr uint KT = QSA_SCORE_KTILES;
    constexpr uint QT_BYTES = QSA_REG_K * NQ * (uint)sizeof(half);
#if QSA_ADDRESS_MODE == 0
    constexpr uint R = QSA_COMPRESS_RATIO;
    constexpr uint PAGE = QSA_PAGE_SIZE;
    constexpr uint SPP = PAGE / R;
    // The A operand is MB consecutive block summaries. A page holds SPP of them, so when
    // a page is smaller than the tile the tile is assembled from MB/SPP whole pages.
    constexpr uint SUB_ROWS = SPP < MB ? SPP : MB;
    constexpr uint SUB_TILES = MB / SUB_ROWS;
#endif

    static_assert(NQ == 16, "the prefill dpas path needs a 512-bit GRF (Xe2 and later)");
    static_assert(DI % QSA_REG_K == 0, "indexer head dim must be a multiple of the dpas K step");
#if QSA_ADDRESS_MODE == 0
    static_assert(SPP % MB == 0 || MB % SPP == 0, "a page must hold a whole number of dpas A tiles, or vice versa");
#endif
    static_assert(QSA_SCORE_QT_TILES * QT_BYTES <= 64 * 1024, "staged query tile exceeds SLM");

    const uint wg = cm_group_id(0);
    if (wg >= num_tiles) {
        return;
    }
    const uint tid = cm_local_id(0);

    uint anchor = 0;       // paged: seq id; dense: batch id
    uint token_begin = 0;  // paged: global first token; dense: first row within the batch row
#if QSA_ADDRESS_MODE == 0
    if (!qsa_ops::resolve_tile_paged(subsequence_begins, num_seqs, wg, NQ, anchor, token_begin)) {
        return;
    }
#else
    const uint tiles_per_row = (seq_len + NQ - 1) / NQ;
    anchor = wg / tiles_per_row;
    token_begin = (wg % tiles_per_row) * NQ;
#endif

    cm_slm_init(QSA_SCORE_QT_TILES * QT_BYTES);
    auto slm_qt = cm_slm_alloc(QSA_SCORE_QT_TILES * QT_BYTES);

#if QSA_ADDRESS_MODE == 0
    const uint seq_begin = (uint)subsequence_begins[anchor];
    const uint seq_end = (uint)subsequence_begins[anchor + 1];
    const uint past_len = (uint)past_lens[anchor];
    const uint page_begin = (uint)block_indices_begins[anchor];
    const uint token0 = token_begin;
    uint valid = seq_end > token0 ? seq_end - token0 : 0;
#else
    const uint past_len = (uint)past_lens[anchor];
    const uint token0 = anchor * seq_len + token_begin;
    uint valid = seq_len > token_begin ? seq_len - token_begin : 0;
#endif
    if (valid > NQ) {
        valid = NQ;
    }

    // Absolute position and visible-block count of every query in the tile.
    vector<uint, NQ> lane;
    cmtl::cm_vector_assign(lane.select_all(), 0, 1);
#if QSA_ADDRESS_MODE == 0
    const vector<uint, NQ> abs_pos = lane + (past_len + token0 - seq_begin);
    const vector<uint, NQ> n_complete = (abs_pos + 1) / (uint)QSA_COMPRESS_RATIO;
#else
    // Dense: past_lens holds key_length; logical position = key_length - seq_len + l, and
    // left-padding rows (negative position) see no complete block.
    const vector<uint, NQ> shifted = lane + (past_len + token_begin);  // abs_pos + seq_len
    vector<uint, NQ> n_complete = (shifted + 1 - seq_len) / (uint)QSA_COMPRESS_RATIO;
    n_complete.merge(0u, shifted < seq_len);
#endif
    const uint n_blocks_max = valid == 0 ? 0 : n_complete[valid - 1];

    // Order-preserving dense-prefix bypass: skip the whole tile before any SLM traffic
    // when even the LAST (highest-position) query in it has too few blocks to need
    // scoring at all - qsa_indexer_topk.cm's own "k == n" bypass never reads these scores.
    if (n_blocks_max <= (uint)QSA_BLOCK_TOPK) {
        return;
    }

    // ---- stage the whole query tile as dpas B operands ----
    // Rows past `valid` are clamped to zero by the descriptor's surface height, so the
    // extra query columns simply produce zero scores that nobody reads.
    const uint q_rows = valid == 0 ? 1 : valid;
    for (uint t = tid; t < QSA_SCORE_QT_TILES; t += WG) {
        const uint h = t / KT;
        const uint k = t % KT;
        vector<half, QSA_REG_K * NQ> tile;
        qsa_dpas::load_vnni_tile(tile,
                                 indexer_q + (token0 * HIQ + h) * DI,
                                 q_rows,
                                 HIQ * DI * (uint)sizeof(half),
                                 DI * (uint)sizeof(half),
                                 k * QSA_REG_K);
        cm_slm_block_write(slm_qt, t * QT_BYTES, tile);
    }
    cm_fence(CM_LOCAL_BARRIER);
    cm_barrier();

    // ---- score every visible block tile ----
    for (uint b0 = tid * MB; b0 < n_blocks_max; b0 += WG * MB) {
        matrix<half, KT, MB * QSA_REG_K> a_tiles;
#if QSA_ADDRESS_MODE == 0
#pragma unroll
        for (uint s = 0; s < SUB_TILES; s++) {
            const uint b = b0 + s * SUB_ROWS;
            if (b >= n_blocks_max) {
                // Past the last visible block: its page id is not in this sequence's page
                // list, so zero the rows instead of indexing out of the table. The scores
                // are never read - the selection is bounded by each query's n_complete.
#pragma unroll
                for (uint k = 0; k < KT; k++) {
                    a_tiles.row(k).select<SUB_ROWS * QSA_REG_K, 1>(s * SUB_ROWS * QSA_REG_K) = (half)0.0f;
                }
                continue;
            }
            const uint page = (uint)block_indices[page_begin + b / SPP];
            const half* sbase = summary_cache + qsa::summary_offset(page, b % SPP, SPP, DI);
#pragma unroll
            for (uint k = 0; k < KT; k++) {
                auto dst = a_tiles.row(k).select<SUB_ROWS * QSA_REG_K, 1>(s * SUB_ROWS * QSA_REG_K);
                qsa_dpas::load_a_tile<SUB_ROWS>(dst, sbase, SUB_ROWS, DI * (uint)sizeof(half), DI * (uint)sizeof(half), k * QSA_REG_K);
            }
        }
#else
        // Dense: no page table, no sub-tile splitting - MB consecutive summaries of one
        // batch row are always contiguous.
        const uint rows = n_blocks_max > b0 ? cm_min<uint>(MB, n_blocks_max - b0) : 0;
        const half* sbase = summary_cache + qsa_ops::offset_dense(anchor, b0, summary_stride, DI);
#pragma unroll
        for (uint k = 0; k < KT; k++) {
            auto dst = a_tiles.row(k).select<MB * QSA_REG_K, 1>(0);
            if (rows == 0) {
                dst = (half)0.0f;
            } else {
                qsa_dpas::load_a_tile<MB>(dst, sbase, rows, DI * (uint)sizeof(half), DI * (uint)sizeof(half), k * QSA_REG_K);
            }
        }
#endif

        vector<float, MB * NQ> acc = 0.0f;
        for (uint h = 0; h < HIQ; h++) {
            vector<float, MB * NQ> st = 0.0f;
#pragma unroll
            for (uint k = 0; k < KT; k++) {
                vector<half, QSA_REG_K * NQ> qt;
                cm_slm_block_read(slm_qt, (h * KT + k) * QT_BYTES, qt);
                st = cm_dpas<CM_PRECISION_HF, CM_PRECISION_HF, QSA_SYSTOLIC_DEPTH, QSA_REG_M, float>(st, qt.format<int32_t>(), a_tiles.row(k).format<int32_t>());
            }
            // ReLU per indexer head, still strictly before the head reduction.
            acc = acc + cm_max<float>(st, 0.0f);
        }
        acc = acc * (float)QSA_IDX_SCALE;  // 1 / sqrt(Di), after the ReLU sum

        // dst is [block][query]; the scores buffer is query-major.
        matrix<float, NQ, MB> scores_t;
        auto acc_m = acc.format<float, MB, NQ>();
        qsa_dpas::transpose_8x16(acc_m.select<8, 1, 16, 1>(0, 0), scores_t.select<16, 1, 8, 1>(0, 0));

        for (uint q = 0; q < valid; q++) {
            if (n_complete[q] <= (uint)QSA_BLOCK_TOPK) {
                continue;  // this query's row is a dense prefix; never published.
            }
            const uint score_row = token0 + q;
            cm_ptr_store<float, MB>(block_scores, (score_row * max_blocks + b0) * (uint)sizeof(float), scores_t.row(q));
        }
    }
}
