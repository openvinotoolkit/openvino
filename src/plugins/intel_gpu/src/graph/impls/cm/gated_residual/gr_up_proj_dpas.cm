// GR DPAS pipeline, stage 3/4: low-rank up projection (read gate logits).
//
//   G[token, c, d] = sigmoid( W_up[c*D+d, :] . t[token, :] )
//
// Same M8/N16/K16 systolic tiling as gr_down_proj_dpas.cm / qsa_project_dpas.cm, just
// with the roles of the two matrix dimensions swapped (K = GR_LOWRANK now, output
// channels = C*D). The full [tokens, C*D] read-gate tensor IS materialized here (unlike
// the original fused gr_read.cm) so it can be combined with Rbar in a cheap, purely
// memory-bound follow-up kernel (gr_combine.cm) - the extra scratch traffic is
// negligible next to the dpas throughput gained on the two GEMMs.
//
// JIT constants: GR_BRANCHES, GR_HIDDEN, GR_LOWRANK.
// Dispatch: gws = [(GR_BRANCHES*GR_HIDDEN)/8, ceil(num_tokens/16), 1], lws = [1, 1, 1].

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif
#include "qsa_dpas_common.hpp"

extern "C" _GENX_MAIN_ void KERNEL_NAME(const half* t_in ATTR,    // [tokens, L]
                                        const half* w_up ATTR,    // [C*D, L]
                                        half* gate_out ATTR,      // [tokens, C*D]
                                        uint32_t num_tokens) {
    constexpr uint CD = GR_BRANCHES * GR_HIDDEN;
    constexpr uint L = GR_LOWRANK;
    constexpr uint M = QSA_REG_M;
    constexpr uint N = QSA_REG_N;
    static_assert(N == 16, "GR DPAS requires 512-bit GRFs (Xe2+)");
    static_assert(L >= 32 && L % 32 == 0, "2D surfaces require >=64B width and 64B-aligned row pitch");
    static_assert(CD % M == 0, "C*D must be divisible by 8; partial output tiles unsupported");

    const uint j0 = cm_group_id(0) * M;
    const uint t0 = cm_group_id(1) * N;
    if (j0 >= CD || t0 >= num_tokens) return;
    const uint valid = cm_min<uint>(N, num_tokens - t0);
    vector<float, M * N> acc = 0.0f;
    for (uint k = 0; k < L; k += QSA_REG_K) {
        vector<half, QSA_REG_K * N> b;
        vector<half, M * QSA_REG_K> a;
        qsa_dpas::load_vnni_tile(b, t_in + t0 * L, valid, L * (uint)sizeof(half), L * (uint)sizeof(half), k);
        qsa_dpas::load_a_tile<M>(a, w_up + j0 * L, M, L * (uint)sizeof(half), L * (uint)sizeof(half), k);
        acc = cm_dpas<CM_PRECISION_HF, CM_PRECISION_HF, QSA_SYSTOLIC_DEPTH, QSA_REG_M, float>(acc, b.format<int32_t>(), a.format<int32_t>());
    }
    matrix<float, N, M> token_major;
    auto result = acc.format<float, M, N>();
    qsa_dpas::transpose_8x16(result.select<8, 1, 16, 1>(0, 0), token_major.select<16, 1, 8, 1>(0, 0));
    for (uint t = 0; t < valid; ++t) {
        vector<float, M> logits = token_major.row(t);
        vector<float, M> gate = qsa_gr::sigmoid<M>(logits);
        vector<half, M> outp = gate;
        cm_ptr_store<int, M / 2>((int*)gate_out, ((t0 + t) * CD + j0) * (uint)sizeof(half), outp.format<int>());
    }
}
