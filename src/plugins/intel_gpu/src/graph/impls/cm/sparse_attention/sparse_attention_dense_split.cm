// Q3 decode, split-selected-KV variant (dense, read-only main K/V), pass 1 - per-partition
// partial softmax.
//
// Dense counterpart of sparse_attention_paged_split.cm: same partition-the-selected-list
// + exclusive-tail-owner design, addressed directly through `[B, Hkv, S, D]` strides (no
// page table). Positions follow sparse_attention_dense.cm exactly: left-padded K/V with
// `pad_k = S - key_length[b]`, causal position `q_abs = key_length[b] - L + l`, and a
// left-padding query row attends nothing (its partitions are empty). No output gate.
//
// JIT constants: QSA_HEADS, QSA_KV_HEADS, QSA_K_HEAD_SIZE, QSA_V_HEAD_SIZE,
// QSA_COMPRESS_RATIO, QSA_BLOCK_TOPK, QSA_SCALE, QSA_SPLIT_PARTITIONS
//
// Dispatch: gws = [QSA_HEADS, B*L, QSA_SPLIT_PARTITIONS], lws = [1, 1, 1]

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_ops_common.hpp"

#define QSA_SPLIT_DENSE_LOG2E 1.4426950408889634f

CM_INLINE void sparse_attention_split_dense_softmax_step(float score, float& running_max, float& running_sum, float& corr, float& weight) {
    const float new_max = running_max > score ? running_max : score;
    vector<float, 2> e;
    e[0] = (running_max - new_max) * QSA_SPLIT_DENSE_LOG2E;
    e[1] = (score - new_max) * QSA_SPLIT_DENSE_LOG2E;
    e = cm_exp(e);
    corr = e[0];
    weight = e[1];
    running_sum = running_sum * corr + weight;
    running_max = new_max;
}

template <int DH, int DV, int HKV, int SPAN>
CM_INLINE void sparse_attention_split_attend_span_dense(vector_ref<float, DH> q, vector_ref<float, DV> acc, float& running_max, float& running_sum,
                                                        const half* key ATTR, const half* value ATTR, uint batch, uint kv_head, uint k_pitch,
                                                        uint v_pitch, uint pos0) {
    const uint base_k = qsa_ops::kv_offset_dense(batch, kv_head, pos0, HKV, k_pitch, DH);
    const uint base_v = qsa_ops::kv_offset_dense(batch, kv_head, pos0, HKV, v_pitch, DV);

    vector<half, SPAN * DH> ktile;
    qsa_gr::load_hv<SPAN * DH>(ktile, key, base_k);
    vector<half, SPAN * DV> vtile;
    qsa_gr::load_hv<SPAN * DV>(vtile, value, base_v);

#pragma unroll
    for (int s = 0; s < SPAN; s++) {
        float score = 0.0f;
#pragma unroll
        for (int k = 0; k < DH; k += 16) {
            vector<float, 16> kv = ktile.template select<16, 1>(s * DH + k);
            score += cm_sum<float>(q.template select<16, 1>(k) * kv);
        }

        float corr = 0.0f;
        float weight = 0.0f;
        sparse_attention_split_dense_softmax_step(score, running_max, running_sum, corr, weight);

#pragma unroll
        for (int k = 0; k < DV; k += 16) {
            vector<float, 16> vv = vtile.template select<16, 1>(s * DV + k);
            acc.template select<16, 1>(k) = acc.template select<16, 1>(k) * corr + vv * weight;
        }
    }
}

extern "C" _GENX_MAIN_ void KERNEL_NAME(const half* query ATTR,               // [B, Hq, L, Dh]
                                        const half* key ATTR,                 // [B, Hkv, S, Dh], dense history
                                        const half* value ATTR,               // [B, Hkv, S, Dv], dense history
                                        const int32_t* selected_blocks ATTR,  // [B*L, block_topk]
                                        const int32_t* selected_counts ATTR,  // [B*L]
                                        const int32_t* key_length ATTR,       // [B]
                                        float* partial_acc ATTR,              // [B*L, Hq, P, Dv]
                                        float* partial_ml ATTR,               // [B*L, Hq, P, 2]
                                        uint32_t seq_len,                     // L
                                        uint32_t history_len,                 // S
                                        uint32_t num_rows,                    // B*L
                                        uint32_t k_seq_pitch,                 // padded S of key
                                        uint32_t v_seq_pitch) {               // padded S of value
    constexpr uint HQ = QSA_HEADS;
    constexpr uint HKV = QSA_KV_HEADS;
    constexpr uint DH = QSA_K_HEAD_SIZE;
    constexpr uint DV = QSA_V_HEAD_SIZE;
    constexpr uint R = QSA_COMPRESS_RATIO;
    constexpr uint K_TOPK = QSA_BLOCK_TOPK;
    constexpr uint P = QSA_SPLIT_PARTITIONS;

    static_assert(DH % 16 == 0 && DV % 16 == 0, "head sizes must be multiples of 16");
    static_assert(P > 0 && HQ % HKV == 0, "invalid split geometry");

    const uint head = cm_global_id(0);
    const uint row = cm_global_id(1);
    const uint part = cm_global_id(2);
    if (head >= HQ || row >= num_rows || part >= P) {
        return;
    }

    const uint batch = row / seq_len;
    const uint l = row - batch * seq_len;
    uint kl = (uint)key_length[batch];
    kl = kl < history_len ? kl : history_len;
    // Left-padded K/V: logical key j of this row is stored at row (history_len - kl) + j.
    key += (history_len - kl) * DH;
    value += (history_len - kl) * DV;
    const bool pad_row = kl + l < seq_len;
    const uint q_abs = kl + l - seq_len;  // RST q_abs = key_length - L + l, valid unless pad_row
    const uint kv_head = head / (HQ / HKV);

    vector<half, DH> q_h;
    qsa_gr::load_hv<DH>(q_h, query, ((batch * HQ + head) * seq_len + l) * DH);
    vector<float, DH> q = q_h;
    q = q * (float)QSA_SCALE;

    float running_max = -1e30f;
    float running_sum = 0.0f;
    vector<float, DV> acc = 0.0f;

    const uint count = pad_row ? 0 : (uint)selected_counts[row];
    const uint selected = count < K_TOPK ? count : K_TOPK;
    const uint begin = selected * part / P;
    const uint end = selected * (part + 1) / P;
    for (uint i = begin; i < end; i++) {
        const int32_t b = selected_blocks[row * K_TOPK + i];
        if (b < 0) {
            continue;
        }
        sparse_attention_split_attend_span_dense<DH, DV, HKV, R>(q, acc, running_max, running_sum, key, value, batch, kv_head, k_seq_pitch, v_seq_pitch,
                                                                 (uint)b * R);
    }
    if (part == P - 1 && !pad_row) {
        for (uint pos = qsa_ops::num_complete_blocks(q_abs) * R; pos <= q_abs; pos++) {
            sparse_attention_split_attend_span_dense<DH, DV, HKV, 1>(q, acc, running_max, running_sum, key, value, batch, kv_head, k_seq_pitch, v_seq_pitch,
                                                                     pos);
        }
    }

    const uint out_row = (row * HQ + head) * P + part;
    partial_ml[out_row * 2] = running_max;
    partial_ml[out_row * 2 + 1] = running_sum;
#pragma unroll
    for (uint k = 0; k < DV; k += 16) {
        vector<float, 16> a = acc.select<16, 1>(k);
        cm_ptr_store<float, 16>(partial_acc, (out_row * DV + k) * (uint)sizeof(float), a);
    }
}
