// Q0 - SparsePA main K/V cache write.
//
// Byte-for-byte the proven qsa_kv_cache_update.cm address arithmetic; only macro names
// are local to the split ops (QSA_PAGE_SIZE instead of QSA_PA_BLOCK_SIZE).
//
// JIT constants: QSA_KV_HEADS, QSA_K_HEAD_SIZE, QSA_V_HEAD_SIZE, QSA_PAGE_SIZE
//
// Dispatch: gws = [1, QSA_KV_HEADS, wg_count * wg_size], lws = [1, 1, wg_size]

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_ops_common.hpp"

template <int HEAD_SIZE>
CM_INLINE void sparse_attention_copy_head(const half* src ATTR, half* cache ATTR, uint src_elem, uint dst_elem) {
    vector<half, HEAD_SIZE> v;
    qsa_gr::load_hv<HEAD_SIZE>(v, src, src_elem);
    qsa_gr::store_hv<HEAD_SIZE>(cache, dst_elem, v);
}

extern "C" _GENX_MAIN_ void KERNEL_NAME(const half* key ATTR,                      // [num_tokens, Hkv*Dh] token-major
                                        const half* value ATTR,                    // [num_tokens, Hkv*Dv] token-major
                                        const int32_t* past_lens ATTR,             // [num_seqs]
                                        const int32_t* block_indices ATTR,         // [used_blocks]
                                        const int32_t* block_indices_begins ATTR,  // [num_seqs+1]
                                        const int32_t* subsequence_begins ATTR,    // [num_seqs+1]
                                        half* key_cache ATTR,                      // [num_blocks, Hkv, page_size, Dh]
                                        half* value_cache ATTR,                    // [num_blocks, Hkv, page_size, Dv]
                                        uint32_t key_pitch,
                                        uint32_t key_offset,
                                        uint32_t value_pitch,
                                        uint32_t value_offset,
                                        uint32_t batch_size_in_sequences) {
    constexpr uint KV_HEADS = QSA_KV_HEADS;
    constexpr uint K_HEAD = QSA_K_HEAD_SIZE;
    constexpr uint V_HEAD = QSA_V_HEAD_SIZE;
    constexpr uint PAGE = QSA_PAGE_SIZE;

    static_assert(K_HEAD % 16 == 0 && V_HEAD % 16 == 0, "head sizes must be multiples of 16");

    const uint head_idx = cm_group_id(1);
    const uint token_idx = cm_global_id(2);

    if (token_idx >= (uint)subsequence_begins[batch_size_in_sequences]) {
        return;
    }

    uint seq = 0;
    for (uint i = 0; i < batch_size_in_sequences; i++) {
        if (token_idx >= (uint)subsequence_begins[i] && token_idx < (uint)subsequence_begins[i + 1]) {
            seq = i;
            break;
        }
    }

    const uint seq_begin = (uint)subsequence_begins[seq];
    const uint past_len = (uint)past_lens[seq];
    const uint abs_pos = past_len + token_idx - seq_begin;

    const uint page = abs_pos / PAGE;
    const uint token_in_page = abs_pos % PAGE;
    const uint physical_page = (uint)block_indices[(uint)block_indices_begins[seq] + page];

    const uint k_src = key_offset + token_idx * key_pitch + head_idx * K_HEAD;
    const uint v_src = value_offset + token_idx * value_pitch + head_idx * V_HEAD;

    sparse_attention_copy_head<K_HEAD>(key, key_cache, k_src, qsa::kv_cache_offset(physical_page, head_idx, token_in_page, KV_HEADS, PAGE, K_HEAD));
    sparse_attention_copy_head<V_HEAD>(value, value_cache, v_src, qsa::kv_cache_offset(physical_page, head_idx, token_in_page, KV_HEADS, PAGE, V_HEAD));
}
