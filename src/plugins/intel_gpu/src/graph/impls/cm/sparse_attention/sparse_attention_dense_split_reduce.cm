// Q3 decode, split-selected-KV variant (dense, read-only main K/V), pass 2 - merge pass.
//
// Dense counterpart of sparse_attention_paged_split_reduce.cm: identical online-softmax
// merge of QSA_SPLIT_PARTITIONS partial states; writes directly into the op's own
// `[B, Hq, L, Dv]` output layout (bottom-right causal addressing is already resolved by
// pass 1, this pass only merges per-row partitions).
//
// JIT constants: QSA_HEADS, QSA_V_HEAD_SIZE, QSA_SPLIT_PARTITIONS, QSA_REDUCE_COLS
//
// Dispatch: gws = [QSA_HEADS, B*L, QSA_V_HEAD_SIZE / QSA_REDUCE_COLS], lws = [1, 1, 1]

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_gr_common.hpp"

extern "C" _GENX_MAIN_ void KERNEL_NAME(const float* partial_acc ATTR,  // [B*L, Hq, P, Dv]
                                        const float* partial_ml ATTR,  // [B*L, Hq, P, 2]
                                        half* output ATTR,             // [B, Hq, L, Dv]
                                        uint32_t seq_len,              // L
                                        uint32_t num_rows) {           // B*L
    constexpr uint HQ = QSA_HEADS;
    constexpr uint DV = QSA_V_HEAD_SIZE;
    constexpr uint P = QSA_SPLIT_PARTITIONS;
    constexpr uint COLS = QSA_REDUCE_COLS;
    static_assert(P == 4 || P == 8 || P == 16 || P == 32 || P == 64, "partition (max, sum) pairs are loaded as whole vectors");
    static_assert(COLS % 16 == 0 && DV % COLS == 0, "invalid reduce column slice");

    const uint head = cm_global_id(0);
    const uint row = cm_global_id(1);
    const uint col0 = cm_global_id(2) * COLS;
    if (head >= HQ || row >= num_rows || col0 >= DV) {
        return;
    }

    const uint row0 = (row * HQ + head) * P;
    constexpr uint ML_CHUNK = 2 * P < 64 ? 2 * P : 64;
    vector<float, 2 * P> ml;
#pragma unroll
    for (uint i = 0; i < 2 * P; i += ML_CHUNK) {
        ml.select<ML_CHUNK, 1>(i) = cm_ptr_load<float, ML_CHUNK>(partial_ml, (row0 * 2 + i) * (uint)sizeof(float));
    }
    const vector<float, P> lsum = ml.select<P, 2>(1);
    vector<float, P> m = ml.select<P, 2>(0);
    m.merge(-1e30f, lsum <= 0.0f);
    const float m_max = cm_reduced_max<float>(m);
    vector<float, P> w = cm_exp((m - m_max) * qsa_gr::LOG2E);
    w.merge(0.0f, lsum <= 0.0f);
    const float sum = cm_sum<float>(w * lsum);

    vector<float, COLS> acc = 0.0f;
    // Every producer writes all P rows (zeros when empty), so unconditional loads are safe.
#pragma unroll
    for (uint p = 0; p < P; p++) {
        vector<float, COLS> a = cm_ptr_load<float, COLS>(partial_acc, ((row0 + p) * DV + col0) * (uint)sizeof(float));
        acc += a * w[p];
    }
    const float inv_sum = sum > 0.0f ? 1.0f / sum : 0.0f;

    const uint batch = row / seq_len;
    const uint l = row - batch * seq_len;
    vector<half, COLS> out = acc * inv_sum;
    qsa_gr::store_hv<COLS>(output, ((batch * HQ + head) * seq_len + l) * DV + col0, out);
}
