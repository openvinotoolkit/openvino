// Q2 decode, pass 2 - qsa_topk_finalization
//
// Merges the per-partition scores into an exact global top-k using the
// order-preserving radix select of qsa_common.hpp. Emitting per-partition local
// top-k lists and merging them would create num_partitions * block_topk
// candidates; radix select costs a few extra passes over an array that is 1/Di
// of the summary traffic and gives a deterministic tie-break.
//
// Effective width: min(block_topk, n_complete). Unused slots are marked -1 and
// described by selected_counts, so Q3 never computes an address from them.
// QSA_DENSE_BYPASS defaults to 1: n_complete <= block_topk reads NO scores.
// A score producer using QSA_DENSE_SCORE_BYPASS=1 must be paired with this mode;
// compiling this finalizer with QSA_DENSE_BYPASS=0 requires all valid scores.
//
// Dispatch:
//   gws = [num_tokens, 1, 1]
//   lws = [1, 1, 1]

// ATTR must be defined by every kernel outside of any include guard: the codegen
// appends an `#undef ATTR` at the end of each kernel it inlines a header into, and a
// guarded redefinition is skipped for every kernel after the first one in a batched
// program, leaving ATTR undefined in the signature below.
#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_score_common.hpp"

#ifndef QSA_SCORE_ROW_CHUNK
#define QSA_SCORE_ROW_CHUNK 0
#endif

extern "C" _GENX_MAIN_ void KERNEL_NAME(const float* block_scores ATTR,         // [num_tokens, max_blocks]
                                        const int32_t* past_lens ATTR,          // [num_seqs]
                                        const int32_t* subsequence_begins ATTR,  // [num_seqs+1]
                                        int32_t* selected_blocks ATTR,           // [num_tokens, block_topk]
                                        int32_t* selected_counts ATTR,           // [num_tokens]
                                        uint32_t num_tokens,
                                        uint32_t num_seqs,
#if QSA_SCORE_ROW_CHUNK
                                        uint32_t max_blocks, uint32_t row_begin, uint32_t row_end) {
#else
                                        uint32_t max_blocks) {
#endif
    constexpr uint K = QSA_BLOCK_TOPK;

#if QSA_SCORE_ROW_CHUNK
    const uint token_idx = cm_global_id(0) + row_begin;
    if (token_idx >= row_end) return;
    const uint score_row = token_idx - row_begin;
#else
    const uint token_idx = cm_global_id(0);
    const uint score_row = token_idx;
#endif
    if (token_idx >= num_tokens) {
        return;
    }

    uint seq = 0;
    uint abs_pos = 0;
    qsa_resolve_token(subsequence_begins, past_lens, num_seqs, token_idx, seq, abs_pos);

    const uint n_complete = qsa_num_complete_blocks(abs_pos);
    int32_t* out = selected_blocks + token_idx * K;

    const uint written = qsa::radix_select_topk(block_scores + score_row * max_blocks, n_complete, K, out);

    for (uint i = written; i < K; i++) {
        out[i] = -1;  // invalid marker; skipped before any address computation in Q3
    }
    selected_counts[token_idx] = (int32_t)written;
}
