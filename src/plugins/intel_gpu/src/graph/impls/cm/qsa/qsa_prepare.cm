// Q1 - qsa_prepare
//
// One work-group owns one (sequence, QSA compression block) pair. This single
// ownership rule covers all three variants of design section 6.2 at once:
//   * prefill    -> many blocks per sequence, each fully owned (prefill_block_local);
//   * decode     -> the single appended token lands in exactly one block (decode_append);
//   * mixed      -> the host emits the touched (sequence, block) pairs per segment
//                   (mixed_segmented); a work-group never spans two sequences.
//
// Fused chain with register/SLM-level reuse (design section 6.2):
//   indexer Q/K projection (CM tiled GEMM, no oneDNN)
//     -> indexer Q: RMSNorm + partial RoPE at the token's own position
//     -> indexer raw K: cache layout transform ONLY (no norm, no RoPE)
//     -> completed QSA block: FP32 mean pooling -> block-key RMSNorm
//        -> partial RoPE at the BLOCK START position -> summary write
//
// This kernel never touches the main KV cache; that is Q0's job.
//
// JIT constants:
//   QSA_HIDDEN, QSA_IDX_HEADS, QSA_IDX_HEAD_DIM, QSA_IDX_ROTARY_DIM,
//   QSA_COMPRESS_RATIO, QSA_PA_BLOCK_SIZE, QSA_IDX_NORM_EPS, QSA_PREPARE_WG
//
// Dispatch:
//   gws = [1, 1, num_wg * QSA_PREPARE_WG]
//   lws = [1, 1, QSA_PREPARE_WG]

// ATTR must be defined by every kernel outside of any include guard: the codegen
// appends an `#undef ATTR` at the end of each kernel it inlines a header into, and a
// guarded redefinition is skipped for every kernel after the first one in a batched
// program, leaving ATTR undefined in the signature below.
#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_common.hpp"

#define QSA_PROJ_WIDTH ((QSA_IDX_HEADS + 1) * QSA_IDX_HEAD_DIM)

#ifndef QSA_PREPROJECTED
#define QSA_PREPROJECTED 0
#endif

extern "C" _GENX_MAIN_ void KERNEL_NAME(
#if QSA_PREPROJECTED
                                        const float* projected ATTR,           // [num_tokens, J], FP32 (not half)
#endif
                                        const half* mixed ATTR,                 // [num_tokens, D] GR READ/MIX output
                                        const half* idx_qk_weight ATTR,         // [(Hidx+1)*Di, D] row-major
                                        const half* q_norm_weight ATTR,         // [Di]
                                        const half* k_norm_weight ATTR,         // [Di]
                                        const half* rotary ATTR,                // [max_positions, rotary_dim] (cos,sin) pairs
                                        const int32_t* position_ids ATTR,       // [num_tokens]
                                        const int32_t* past_lens ATTR,          // [num_seqs]
                                        const int32_t* subsequence_begins ATTR,  // [num_seqs+1]
                                        const int32_t* block_indices ATTR,       // [used_blocks]
                                        const int32_t* block_indices_begins ATTR,  // [num_seqs+1]
                                        half* raw_k_cache ATTR,                    // [num_blocks, 1, PA_BLOCK_SIZE, Di]
                                        half* summary_cache ATTR,                  // [num_blocks, 1, PA_BLOCK_SIZE/r, Di]
                                        half* indexer_q ATTR,                      // [num_tokens, Hidx, Di]
                                        const int32_t* prepare_map ATTR,           // [num_wg, 2] = (seq, qsa_block_id)
                                        uint32_t num_wg) {
    constexpr uint D = QSA_HIDDEN;
    constexpr uint HIDX = QSA_IDX_HEADS;
    constexpr uint DI = QSA_IDX_HEAD_DIM;
    constexpr uint ROT = QSA_IDX_ROTARY_DIM;
    constexpr uint R = QSA_COMPRESS_RATIO;
    constexpr uint PA_BLOCK = QSA_PA_BLOCK_SIZE;
    constexpr uint WG = QSA_PREPARE_WG;
    constexpr uint J = QSA_PROJ_WIDTH;
    constexpr uint SUMMARIES_PER_PAGE = PA_BLOCK / R;

    static_assert(DI % 16 == 0, "indexer head dim must be a multiple of 16");
    static_assert(D % 16 == 0, "hidden size must be a multiple of 16");
    static_assert(PA_BLOCK % R == 0, "PA_BLOCK_SIZE must be divisible by compress_ratio");
    static_assert(HIDX + 1 <= WG, "one thread per indexer head plus one for raw K");

    // Widest contiguous chunk that always divides D, so activation staging and the weight
    // stream use as few LSC messages as the shape allows (256 B when D % 128 == 0).
    constexpr uint KC = (D % 128 == 0) ? 128 : ((D % 64 == 0) ? 64 : ((D % 32 == 0) ? 32 : 16));

    const uint wg = cm_group_id(2);
    if (wg >= num_wg) {
        return;
    }
    const uint tid = cm_local_id(2);

    constexpr uint SLM_PROJ_SIZE = J * (uint)sizeof(float);
    constexpr uint SLM_RAWK_SIZE = R * DI * (uint)sizeof(float);
    constexpr uint SLM_POOL_SIZE = DI * (uint)sizeof(float);
#if QSA_PREPROJECTED
    cm_slm_init(SLM_PROJ_SIZE + SLM_RAWK_SIZE + SLM_POOL_SIZE);
#else
    constexpr uint SLM_MIXED_SIZE = D * (uint)sizeof(half);
    cm_slm_init(SLM_PROJ_SIZE + SLM_RAWK_SIZE + SLM_POOL_SIZE + SLM_MIXED_SIZE);
#endif
    auto slm_proj = cm_slm_alloc(SLM_PROJ_SIZE);
    auto slm_rawk = cm_slm_alloc(SLM_RAWK_SIZE);
    auto slm_pool = cm_slm_alloc(SLM_POOL_SIZE);
#if !QSA_PREPROJECTED
    auto slm_mixed = cm_slm_alloc(SLM_MIXED_SIZE);
#endif

    const uint seq = (uint)prepare_map[wg * 2 + 0];
    const uint qsa_block = (uint)prepare_map[wg * 2 + 1];

    const uint seq_begin = (uint)subsequence_begins[seq];
    const uint q_len = (uint)subsequence_begins[seq + 1] - seq_begin;
    const uint past_len = (uint)past_lens[seq];
    const uint total_len = past_len + q_len;
    const uint page_begin = (uint)block_indices_begins[seq];

    const uint block_start = qsa_block * R;
    const uint block_end = block_start + R;

    // New tokens of this sequence that fall into this QSA block form a contiguous range.
    const uint lo = block_start > past_len ? block_start : past_len;
    const uint hi = block_end < total_len ? block_end : total_len;

    for (uint p = lo; p < hi; p++) {
        const uint token_idx = seq_begin + (p - past_len);

#if QSA_PREPROJECTED
        // Separate in-order dispatch makes all FP32 projection rows visible.
        // In particular, do not reload freshly generated raw K from the half cache.
        for (uint j0 = tid * 16; j0 < J; j0 += WG * 16) {
            vector<float, 16> out = cm_ptr_load<float, 16>(
                projected, (token_idx * J + j0) * (uint)sizeof(float));
            cm_slm_block_write(slm_proj, j0 * (uint)sizeof(float), out);
        }
#else
        // Stage the activation row once per token. Every output tile of the projection
        // reads the SAME D elements, so reading it from global memory inside the tile
        // loop would multiply the activation traffic by the number of tiles (J/16).
        for (uint k0 = tid * KC; k0 < D; k0 += WG * KC) {
            vector<half, KC> x;
            qsa_gr::load_hv<KC>(x, mixed, token_idx * D + k0);
            cm_slm_block_write(slm_mixed, k0 * (uint)sizeof(half), x);
        }
        cm_fence(CM_LOCAL_BARRIER);
        cm_barrier();

        // ---- indexer Q/K projection: out[j] = W[j,:] . mixed[token,:] ----
        for (uint j0 = tid * 16; j0 < J; j0 += WG * 16) {
            vector<float, 16> out = 0.0f;
#pragma unroll
            for (uint jj = 0; jj < 16; jj++) {
                const uint w_row = (j0 + jj) * D;
                float acc = 0.0f;
                for (uint k = 0; k < D; k += KC) {
                    // Weights stream from DRAM: one wide message per step, not KC/16 narrow ones.
                    vector<half, KC> w;
                    qsa_gr::load_hv<KC>(w, idx_qk_weight, w_row + k);
                    vector<half, KC> x;
                    cm_slm_block_read(slm_mixed, k * (uint)sizeof(half), x);
#pragma unroll
                    for (uint t = 0; t < KC; t += 16) {
                        vector<float, 16> wv = w.select<16, 1>(t);
                        vector<float, 16> xv = x.select<16, 1>(t);
                        acc += cm_sum<float>(wv * xv);
                    }
                }
                out[jj] = acc;
            }
            cm_slm_block_write(slm_proj, j0 * (uint)sizeof(float), out);
        }
#endif
        cm_fence(CM_LOCAL_BARRIER);
        cm_barrier();

        if (tid < HIDX) {
            // Indexer query: RMSNorm first, then partial RoPE at the token's own position.
            vector<float, DI> q;
            cm_slm_block_read(slm_proj, (tid * DI) * (uint)sizeof(float), q);
            qsa::rms_norm<DI>(q, q_norm_weight, (float)QSA_IDX_NORM_EPS);
            qsa::apply_partial_rope<DI, ROT>(q, rotary, (uint)position_ids[token_idx]);
            vector<half, DI> q_out = q;
            qsa_gr::store_hv<DI>(indexer_q, (token_idx * HIDX + tid) * DI, q_out);
        } else if (tid == HIDX) {
            // Indexer raw key: layout transform only. No token-level RMSNorm and no RoPE
            // before the cache write - the summary path applies both later.
            vector<float, DI> kv;
            cm_slm_block_read(slm_proj, (HIDX * DI) * (uint)sizeof(float), kv);

            const uint page = (uint)block_indices[page_begin + p / PA_BLOCK];
            const uint dst = qsa::raw_k_offset(page, p % PA_BLOCK, PA_BLOCK, DI);
            vector<half, DI> raw_out = kv;
            qsa_gr::store_hv<DI>(raw_k_cache, dst, raw_out);
            // Keep the freshly produced raw key in SLM so that pooling below does not have
            // to depend on the global-memory write becoming visible again.
            cm_slm_block_write(slm_rawk, ((p - block_start) * DI) * (uint)sizeof(float), kv);
        }
        cm_fence(CM_LOCAL_BARRIER);
        cm_barrier();
    }

    // ------------------------------------------------------------------
    // Block completion: only a QSA block with all R slots filled produces a summary.
    // An incomplete tail block updates nothing here; Q3 re-adds its tokens as
    // always-visible tail tokens.
    // ------------------------------------------------------------------
    if (block_end > total_len) {
        return;
    }

    // FP32 mean pooling of the R raw keys. Slots below past_len come from the cache
    // (written by an earlier dispatch); the rest are still in SLM.
    for (uint d0 = tid * 16; d0 < DI; d0 += WG * 16) {
        vector<float, 16> acc = 0.0f;
        for (uint s = 0; s < R; s++) {
            const uint p = block_start + s;
            if (p >= past_len) {
                vector<float, 16> v;
                cm_slm_block_read(slm_rawk, (s * DI + d0) * (uint)sizeof(float), v);
                acc += v;
            } else {
                const uint page = (uint)block_indices[page_begin + p / PA_BLOCK];
                const uint src = qsa::raw_k_offset(page, p % PA_BLOCK, PA_BLOCK, DI);
                vector<float, 16> v = qsa_gr::load_h16(raw_k_cache, src + d0);
                acc += v;
            }
        }
        acc = acc * (1.0f / (float)R);
        cm_slm_block_write(slm_pool, d0 * (uint)sizeof(float), acc);
    }
    cm_fence(CM_LOCAL_BARRIER);
    cm_barrier();

    if (tid == 0) {
        vector<float, DI> pooled;
        cm_slm_block_read(slm_pool, 0, pooled);
        qsa::rms_norm<DI>(pooled, k_norm_weight, (float)QSA_IDX_NORM_EPS);
        // RoPE position of a summary is the BLOCK START position, not the block index
        // and not the last token of the block.
        qsa::apply_partial_rope<DI, ROT>(pooled, rotary, block_start);

        const uint page = (uint)block_indices[page_begin + qsa_block / SUMMARIES_PER_PAGE];
        const uint dst = qsa::summary_offset(page, qsa_block % SUMMARIES_PER_PAGE, SUMMARIES_PER_PAGE, DI);
        vector<half, DI> summary_out = pooled;
        qsa_gr::store_hv<DI>(summary_cache, dst, summary_out);
    }
}
