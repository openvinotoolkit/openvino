// Q3 decode, split-selected-KV variant, pass 1: [head, token, partition], one thread
// per segment. See qsa_sparse_attention_split_reduce.cm for the merge pass.
#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif
#include "qsa_split_span.hpp"

extern "C" _GENX_MAIN_ void KERNEL_NAME(const half* query ATTR,
    const half* key_cache ATTR, const half* value_cache ATTR,
    const int32_t* past_lens ATTR, const int32_t* subsequence_begins ATTR,
    const int32_t* block_indices ATTR, const int32_t* block_indices_begins ATTR,
    const int32_t* selected_blocks ATTR, const int32_t* selected_counts ATTR,
    float* partial_acc ATTR, float* partial_ml ATTR,
    uint32_t num_tokens, uint32_t num_seqs, uint32_t q_base,
    uint32_t q_pitch, uint32_t q_head_stride, uint32_t gate_delta) {
    constexpr uint HQ = QSA_HEADS, HKV = QSA_KV_HEADS;
    constexpr uint DH = QSA_K_HEAD_SIZE, DV = QSA_V_HEAD_SIZE;
    constexpr uint R = QSA_COMPRESS_RATIO, PA_BLOCK = QSA_PA_BLOCK_SIZE;
    constexpr uint K_TOPK = QSA_BLOCK_TOPK, P = QSA_SPLIT_PARTITIONS;
    static_assert(DH % 16 == 0 && DV % 16 == 0, "head sizes must be multiples of 16");
    static_assert(P > 0 && PA_BLOCK % R == 0 && HQ % HKV == 0, "invalid split geometry");
    const uint head = cm_global_id(0), token_idx = cm_global_id(1), part = cm_global_id(2);
    if (head >= HQ || token_idx >= num_tokens || part >= P) return;
    uint seq = 0, abs_pos = 0;
    qsa_resolve_token(subsequence_begins, past_lens, num_seqs, token_idx, seq, abs_pos);
    const uint kv_head = head / (HQ / HKV);
    const uint page_begin = (uint)block_indices_begins[seq];
    vector<half, DH> q_h;
    qsa_gr::load_hv<DH>(q_h, query, q_base + token_idx * q_pitch + head * q_head_stride);
    vector<float, DH> q = q_h;
    q = q * (float)QSA_SCALE;
    float running_max = -1e30f, running_sum = 0.0f;
    vector<float, DV> acc = 0.0f;
    // Caller contract: 0 <= selected_counts <= K. Retain scalar's K bound even
    // for malformed counts. Split SLOT ranges, not absolute KV positions.
    const uint count = (uint)selected_counts[token_idx];
    const uint selected = count < K_TOPK ? count : K_TOPK;
    const uint begin = selected * part / P, end = selected * (part + 1) / P;
    for (uint i = begin; i < end; i++) {
        const int32_t b = selected_blocks[token_idx * K_TOPK + i];
        if (b < 0) continue;  // MUST precede all KV address computation
        qsa_split_attend_span<DH, DV, HKV, PA_BLOCK, R>(q, acc, running_max, running_sum,
            key_cache, value_cache, block_indices, page_begin, kv_head, (uint)b * R);
    }
    // The last partition exclusively owns the incomplete tail, also for K=0.
    if (part == P - 1) {
        for (uint pos = qsa_num_complete_blocks(abs_pos) * R; pos <= abs_pos; pos++) {
            qsa_split_attend_span<DH, DV, HKV, PA_BLOCK, 1>(q, acc, running_max, running_sum,
                key_cache, value_cache, block_indices, page_begin, kv_head, pos);
        }
    }
    const uint row = (token_idx * HQ + head) * P + part;
    partial_ml[row * 2] = running_max;
    partial_ml[row * 2 + 1] = running_sum;
#pragma unroll
    for (uint k = 0; k < DV; k += 16) {
        cm_ptr_store<float, 16>(partial_acc, (row * DV + k) * (uint)sizeof(float), acc.select<16, 1>(k));
    }
    // No normalization, half rounding, or output gate in the producer.
}