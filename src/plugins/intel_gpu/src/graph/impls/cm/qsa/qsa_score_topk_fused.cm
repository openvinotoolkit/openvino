// Q2 prefill - qsa_score_topk_fused
//
// Prefill has plenty of queries, so the parallelism comes from the query axis and
// scoring + top-k collapse into ONE dispatch per query (design section 6.3). The
// summary array of a sequence is shared by every query of that sequence and is
// L2-resident at the 8 MB/layer scale, which is why re-reading it per query tile
// is cheap here while it would dominate decode.
//
// The selection uses exactly the same radix_select_topk() helper as the decode
// finalization kernel, which is what guarantees the prefill and decode variants
// produce bit-identical selected metadata (a required correctness test).
//
// Dispatch:
//   gws = [num_tokens, 1, 1]
//   lws = [1, 1, 1]

// ATTR must be defined by every kernel outside of any include guard: the codegen
// appends an `#undef ATTR` at the end of each kernel it inlines a header into, and a
// guarded redefinition is skipped for every kernel after the first one in a batched
// program, leaving ATTR undefined in the signature below.
#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#include "qsa_score_common.hpp"

extern "C" _GENX_MAIN_ void KERNEL_NAME(const half* indexer_q ATTR,             // [num_tokens, Hidx, Di]
                                        const half* summary_cache ATTR,         // [num_blocks, 1, PA_BLOCK/r, Di]
                                        const int32_t* past_lens ATTR,          // [num_seqs]
                                        const int32_t* subsequence_begins ATTR,  // [num_seqs+1]
                                        const int32_t* block_indices ATTR,       // [used_blocks]
                                        const int32_t* block_indices_begins ATTR,  // [num_seqs+1]
                                        float* block_scores ATTR,                  // [num_tokens, max_blocks] scratch
                                        int32_t* selected_blocks ATTR,             // [num_tokens, block_topk]
                                        int32_t* selected_counts ATTR,             // [num_tokens]
                                        uint32_t num_tokens,
                                        uint32_t num_seqs,
                                        uint32_t max_blocks) {
    constexpr uint K = QSA_BLOCK_TOPK;

    const uint token_idx = cm_global_id(0);
    if (token_idx >= num_tokens) {
        return;
    }

    uint seq = 0;
    uint abs_pos = 0;
    qsa_resolve_token(subsequence_begins, past_lens, num_seqs, token_idx, seq, abs_pos);

    const uint n_complete = qsa_num_complete_blocks(abs_pos);
    const uint page_begin = (uint)block_indices_begins[seq];
    float* row = block_scores + token_idx * max_blocks;

#if QSA_DENSE_BYPASS
    // Scratch is not a score-only output. Dense rows go straight to arange below;
    // Q1 still maintains all indexer key/summary state for future sparse queries.
    if (n_complete > K)
#endif
    {
        matrix<half, QSA_IDX_HEADS, QSA_IDX_HEAD_DIM> q;
        qsa_load_query<QSA_IDX_HEADS, QSA_IDX_HEAD_DIM>(q, indexer_q, token_idx);

        for (uint b = 0; b < n_complete; b++) {
            row[b] = qsa_block_score(q, summary_cache, block_indices, page_begin, b);
        }
    }

    int32_t* out = selected_blocks + token_idx * K;
    const uint written = qsa::radix_select_topk(row, n_complete, K, out);
    for (uint i = written; i < K; i++) {
        out[i] = -1;
    }
    selected_counts[token_idx] = (int32_t)written;
}
