#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_GOOGLE_include_directive : require

#define VULKAN_SHADER_SPECIALIZATION_ID(name, code) const uint specialization_##name##_id = code;
#include "../vulkan_shader_abi.inc"
#undef VULKAN_SHADER_SPECIALIZATION_ID

layout(local_size_x_id = specialization_local_size_x_id, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input {
    uint8_t values[];
} input_data;

layout(set = 0, binding = 1) writeonly buffer Output {
    uint8_t values[];
} output_data;

layout(set = 0, binding = 2) readonly buffer Metadata {
    uint values[];
} metadata;

#define VULKAN_SHADER_SCALAR_TYPE(name, code) const uint type_##name = code;
#include "../vulkan_shader_abi.inc"
#undef VULKAN_SHADER_SCALAR_TYPE

const uint metadata_element_count = 0;
const uint metadata_input_type = 1;
const uint metadata_output_type = 2;

uint scalar_size(uint type) {
    if (type == type_i64) {
        return 8;
    }
    if (type == type_f32 || type == type_i32 || type == type_u32) {
        return 4;
    }
    if (type == type_f16 || type == type_i16 || type == type_u16) {
        return 2;
    }
    return 1;
}

uint load_u8(uint offset) {
    return uint(input_data.values[offset]);
}

uint load_u16(uint offset) {
    return load_u8(offset) | (load_u8(offset + 1) << 8);
}

uint load_u32(uint offset) {
    return load_u16(offset) | (load_u16(offset + 2) << 16);
}

uvec2 load_u64(uint offset) {
    return uvec2(load_u32(offset), load_u32(offset + 4));
}

void store_u8(uint offset, uint value) {
    output_data.values[offset] = uint8_t(value & 0xff);
}

void store_u16(uint offset, uint value) {
    store_u8(offset, value);
    store_u8(offset + 1, value >> 8);
}

void store_u32(uint offset, uint value) {
    store_u16(offset, value);
    store_u16(offset + 2, value >> 16);
}

void store_u64(uint offset, uvec2 value) {
    store_u32(offset, value.x);
    store_u32(offset + 4, value.y);
}

uvec2 sign_extend(uint value, uint bits) {
    if (bits == 32) {
        return uvec2(value, uint(int(value) >> 31));
    }
    uint sign_bit = 1u << (bits - 1);
    uint mask = (1u << bits) - 1;
    uint extended = (value & sign_bit) != 0 ? value | ~mask : value & mask;
    return uvec2(extended, uint(int(extended) >> 31));
}

bool is_float_type(uint type) {
    return type == type_f16 || type == type_f32;
}

bool is_signed_type(uint type) {
    return type == type_i8 || type == type_i16 || type == type_i32 || type == type_i64;
}

uvec2 load_integer(uint element_index, uint type) {
    uint offset = element_index * scalar_size(type);
    if (type == type_i64) {
        return load_u64(offset);
    }
    if (type == type_i32) {
        return sign_extend(load_u32(offset), 32);
    }
    if (type == type_u32) {
        return uvec2(load_u32(offset), 0);
    }
    if (type == type_i16) {
        return sign_extend(load_u16(offset), 16);
    }
    if (type == type_u16) {
        return uvec2(load_u16(offset), 0);
    }
    if (type == type_i8) {
        return sign_extend(load_u8(offset), 8);
    }
    return uvec2(load_u8(offset), 0);
}

float integer_to_float(uvec2 value, bool signed_type) {
    bool negative = signed_type && int(value.y) < 0;
    if (negative) {
        uint low = ~value.x + 1;
        value = uvec2(low, ~value.y + (low == 0 ? 1 : 0));
    }
    float result = float(value.y) * 4294967296.0 + float(value.x);
    return negative ? -result : result;
}

float load_float(uint element_index, uint type) {
    uint offset = element_index * scalar_size(type);
    if (type == type_f32) {
        return uintBitsToFloat(load_u32(offset));
    }
    if (type == type_f16) {
        return unpackHalf2x16(load_u16(offset)).x;
    }
    return integer_to_float(load_integer(element_index, type), is_signed_type(type));
}

void store_integer(uint element_index, uint type, uvec2 value) {
    uint offset = element_index * scalar_size(type);
    if (type == type_i64) {
        store_u64(offset, value);
    } else if (type == type_i32 || type == type_u32) {
        store_u32(offset, value.x);
    } else if (type == type_i16 || type == type_u16) {
        store_u16(offset, value.x);
    } else {
        store_u8(offset, value.x);
    }
}

void store_float(uint element_index, uint type, float value) {
    uint offset = element_index * scalar_size(type);
    if (type == type_f32) {
        store_u32(offset, floatBitsToUint(value));
    } else {
        store_u16(offset, packHalf2x16(vec2(value, 0.0)));
    }
}

uvec2 float_to_integer(float value, bool signed_type) {
    if (signed_type) {
        int converted = int(value);
        return uvec2(uint(converted), converted < 0 ? 0xffffffff : 0);
    }
    return uvec2(uint(value), 0);
}

void main() {
    uint element_index = gl_GlobalInvocationID.x;
    uint element_count = metadata.values[metadata_element_count];
    if (element_index >= element_count) {
        return;
    }

    uint input_type = metadata.values[metadata_input_type];
    uint output_type = metadata.values[metadata_output_type];
    if (is_float_type(output_type)) {
        store_float(element_index, output_type, load_float(element_index, input_type));
    } else if (is_float_type(input_type)) {
        store_integer(element_index, output_type, float_to_integer(load_float(element_index, input_type), is_signed_type(output_type)));
    } else {
        store_integer(element_index, output_type, load_integer(element_index, input_type));
    }
}
