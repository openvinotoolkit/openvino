ir_version: 7
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    output: "roi"
    op_type: "Constant"
    attribute {
      name: "value"
      t {
        dims: 0
        data_type: 1
        name: "const_roi"
      }
      type: TENSOR
    }
  }
  node {
    output: "scales"
    op_type: "Constant"
    attribute {
      name: "value"
      t {
        dims: 2
        data_type: 1
        float_data: 2.0
        float_data: 2.0
        name: "const_scales"
      }
      type: TENSOR
    }
  }
  node {
    output: "axes"
    op_type: "Constant"
    attribute {
      name: "value"
      t {
        dims: 2
        data_type: 7
        int64_data: -2
        int64_data: -1
        name: "const_axes"
      }
      type: TENSOR
    }
  }
  node {
    input: "X"
    input: "roi"
    input: "scales"
    input: ""
    input: "axes"
    output: "Y"
    op_type: "Resize"
    attribute {
      name: "mode"
      s: "nearest"
      type: STRING
    }
    attribute {
      name: "coordinate_transformation_mode"
      s: "asymmetric"
      type: STRING
    }
  }
  name: "test_resize18_negative_axes"
  input {
    name: "X"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim { dim_value: 1 }
          dim { dim_value: 1 }
          dim { dim_value: 2 }
          dim { dim_value: 2 }
        }
      }
    }
  }
  output {
    name: "Y"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim { dim_value: 1 }
          dim { dim_value: 1 }
          dim { dim_value: 4 }
          dim { dim_value: 4 }
        }
      }
    }
  }
}
opset_import {
  domain: ""
  version: 18
}
