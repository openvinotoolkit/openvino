ir_version: 7
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    output: "sizes"
    op_type: "Constant"
    attribute {
      name: "value"
      t {
        dims: 4
        data_type: 7
        name: "const_tensor"
        raw_data: "\001\000\000\000\000\000\000\000\001\000\000\000\000\000\000\000\005\000\000\000\000\000\000\000\007\000\000\000\000\000\000\000"
      }
      type: TENSOR
    }
  }
  node {
    input: "X"
    input: ""
    input: ""
    input: "sizes"
    output: "Y"
    op_type: "Resize"
    attribute {
      name: "coordinate_transformation_mode"
      s: "half_pixel"
      type: STRING
    }
    attribute {
      name: "exclude_outside"
      i: 1
      type: INT
    }
    attribute {
      name: "mode"
      s: "cubic"
      type: STRING
    }
  }
  name: "test-model"
  input {
    name: "X"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1
          }
          dim {
            dim_value: 1
          }
          dim {
            dim_value: 3
          }
          dim {
            dim_value: 4
          }
        }
      }
    }
  }
  output {
    name: "Y"
    type {
      tensor_type {
        elem_type: 1
      }
    }
  }
}
opset_import {
  domain: ""
  version: 13
}
