ir_version: 11
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    input: "past_cache"
    input: "update"
    input: "write_indices"
    output: "present_cache"
    op_type: "TensorScatter"
    attribute {
      name: "axis"
      i: -2
      type: INT
    }
    attribute {
      name: "mode"
      s: "circular"
      type: STRING
    }
  }
  name: "tensor_scatter_circular_large_write_index_graph"
  input {
    name: "past_cache"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim { dim_value: 1 }
          dim { dim_value: 3 }
          dim { dim_value: 1 }
        }
      }
    }
  }
  input {
    name: "update"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim { dim_value: 1 }
          dim { dim_value: 3 }
          dim { dim_value: 1 }
        }
      }
    }
  }
  input {
    name: "write_indices"
    type {
      tensor_type {
        elem_type: 7
        shape {
          dim { dim_value: 1 }
        }
      }
    }
  }
  output {
    name: "present_cache"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim { dim_value: 1 }
          dim { dim_value: 3 }
          dim { dim_value: 1 }
        }
      }
    }
  }
}
opset_import {
  domain: ""
  version: 24
}
