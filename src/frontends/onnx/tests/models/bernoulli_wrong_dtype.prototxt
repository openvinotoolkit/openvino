ir_version: 8
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    input: "x"
    output: "y"
    op_type: "Bernoulli"
    attribute {
      name: "dtype"
      i: 8
      type: INT
    }
  }
  name: "test_bernoulli_wrong_dtype"
  input {
    name: "x"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 6
          }
        }
      }
    }
  }
  output {
    name: "y"
    type {
      tensor_type {
        elem_type: 8
        shape {
          dim {
            dim_value: 6
          }
        }
      }
    }
  }
}
opset_import {
  version: 15
}
