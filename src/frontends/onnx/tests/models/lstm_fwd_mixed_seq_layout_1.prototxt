ir_version: 7
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    input: "X"
    input: "W"
    input: "R"
    input: "B"
    input: "sequence_lens"
    input: ""
    input: ""
    input: ""
    output: "Y"
    output: "Y_h"
    output: "Y_c"
    op_type: "LSTM"
    attribute {
      name: "clip"
      f: 9999.0
      type: FLOAT
    }
    attribute {
      name: "direction"
      s: "forward"
      type: STRING
    }
    attribute {
      name: "hidden_size"
      i: 3
      type: INT
    }
    attribute {
      name: "input_forget"
      i: 0
      type: INT
    }
    attribute {
      name: "layout"
      i: 1
      type: INT
    }
  }
  name: "compute_graph"
  input {
    name: "X"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 2  # seq_length
          }
          dim {
            dim_value: 1  # input size
          }
        }
      }
    }
  }
  input {
    name: "W"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1
          }
          dim {
            dim_value: 12
          }
          dim {
            dim_value: 1
          }
        }
      }
    }
  }
  input {
    name: "R"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1
          }
          dim {
            dim_value: 12
          }
          dim {
            dim_value: 3
          }
        }
      }
    }
  }
  input {
    name: "B"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1
          }
          dim {
            dim_value: 24
          }
        }
      }
    }
  }
  input {
    name: "sequence_lens"
    type {
      tensor_type {
        elem_type: 6
        shape {
          dim {
            dim_value: 2  # batch size
          }
        }
      }
    }
  }
  output {
    name: "Y"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 2  # seq_length
          }
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
  output {
    name: "Y_h"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
  output {
    name: "Y_c"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
}
opset_import {
  version: 14
}
