ir_version: 8
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    input: "X"
    input: "W"
    output: "Y"
    op_type: "Add"
  }
  name: "test_graph"
  initializer {
    dims: 4
    data_type: 1
    name: "W"
    external_data {
        key: "location",
        value: "*/_ORT_MEM_ADDR_/*"
    }
    external_data {
        key: "offset",
        value: "4096"
    }
    external_data {
        key: "length",
        value: "16"
    }
    data_location: 1
  }
  input {
    name: "X"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 4
          }
        }
      }
    }
  }
  output {
    name: "Y"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 4
          }
        }
      }
    }
  }
}
opset_import {
  version: 13
}
