ir_version: 8
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    input: "X"
    input: "W"
    output: "Y"
    op_type: "Add"
    attribute {
      name: "inline_tensor"
      t {
        dims: 1
        data_type: 1
        float_data: 1
        name: "inline_tensor"
      }
      type: TENSOR
    }
    attribute {
      name: "file_tensors"
      tensors {
        dims: 4
        data_type: 1
        name: "file_tensor"
        external_data {
            key: "location",
            value: "tensors_data/tensor.data"
        }
        external_data {
            key: "offset",
            value: "0"
        }
        external_data {
            key: "length",
            value: "16"
        }
        data_location: 1
      }
      type: TENSORS
    }
    attribute {
      name: "sparse_tensor"
      sparse_tensor {
        values {
          dims: 1
          data_type: 1
          float_data: 1
          name: "attr_sparse_values"
        }
        indices {
          dims: 1
          data_type: 7
          int64_data: 0
          name: "attr_sparse_indices"
        }
        dims: 4
      }
      type: SPARSE_TENSOR
    }
    attribute {
      name: "sparse_tensors"
      sparse_tensors {
        values {
          dims: 1
          data_type: 1
          float_data: 1
          name: "attr_sparse_list_values"
        }
        indices {
          dims: 1
          data_type: 7
          int64_data: 0
          name: "attr_sparse_list_indices"
        }
        dims: 4
      }
      type: SPARSE_TENSORS
    }
    attribute {
      name: "empty_mem_graph"
      g {
        name: "empty_mem_graph"
        initializer {
          dims: 0
          data_type: 1
          name: "empty_mem_tensor"
          external_data {
              key: "location",
              value: "*/_ORT_MEM_ADDR_/*"
          }
          external_data {
              key: "offset",
              value: "0"
          }
          external_data {
              key: "length",
              value: "0"
          }
          data_location: 1
        }
      }
      type: GRAPH
    }
    attribute {
      name: "graphs"
      graphs {
        name: "graph_in_list"
      }
      type: GRAPHS
    }
  }
  name: "test_graph"
  initializer {
    dims: 4
    data_type: 1
    float_data: 1
    float_data: 2
    float_data: 3
    float_data: 4
    name: "W"
  }
  sparse_initializer {
    values {
      dims: 1
      data_type: 1
      float_data: 1
      name: "sparse_initializer_values"
    }
    indices {
      dims: 1
      data_type: 7
      int64_data: 0
      name: "sparse_initializer_indices"
    }
    dims: 4
  }
  input {
    name: "X"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 4
          }
        }
      }
    }
  }
  output {
    name: "Y"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 4
          }
        }
      }
    }
  }
}
opset_import {
  version: 13
}
opset_import {
  domain: "custom"
  version: 1
}
functions {
  name: "inline_function"
  domain: "custom"
  output: "out"
  node {
    output: "out"
    op_type: "Constant"
    attribute {
      name: "value_float"
      f: 1
      type: FLOAT
    }
  }
  opset_import {
    version: 13
  }
}
functions {
  name: "mem_function"
  domain: "custom"
  output: "out"
  node {
    output: "out"
    op_type: "Constant"
    attribute {
      name: "value"
      t {
        dims: 4
        data_type: 1
        name: "function_value"
        external_data {
            key: "location",
            value: "*/_ORT_MEM_ADDR_/*"
        }
        external_data {
            key: "offset",
            value: "4096"
        }
        external_data {
            key: "length",
            value: "16"
        }
        data_location: 1
      }
      type: TENSOR
    }
  }
  opset_import {
    version: 13
  }
}
