ir_version: 11
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    input: "x"
    input: "scale"
    output: "y_q"
    name: "QuantizeLinear"
    op_type: "QuantizeLinear"
    attribute {
      name: "output_dtype"
      i: 23
      type: INT
    }
  }
  node {
    input: "y_q"
    input: "scale"
    output: "y"
    name: "DequantizeLinear"
    op_type: "DequantizeLinear"
  }
  name: "test_graph"
  initializer {
    data_type: 1
    name: "scale"
    raw_data: "\000\000\000\100"
  }
  input {
    name: "x"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim { dim_value: 6 }
        }
      }
    }
  }
  output {
    name: "y"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim { dim_value: 6 }
        }
      }
    }
  }
}
opset_import {
  version: 23
}
