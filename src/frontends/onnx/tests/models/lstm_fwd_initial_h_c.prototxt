ir_version: 7
producer_name: "OpenVINO ONNX Frontend"
graph {
  node {
    input: "X"
    input: "W"
    input: "R"
    input: "B"
    input: ""
    input: "initial_h"
    input: "initial_c"
    output: "Y"
    output: "Y_h"
    output: "Y_c"
    op_type: "LSTM"
    attribute {
      name: "direction"
      s: "forward"
      type: STRING
    }
    attribute {
      name: "hidden_size"
      i: 3
      type: INT
    }
  }
  name: "test_lstm_fwd_initial_h_c"
  input {
    name: "X"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 3  # seq_length
          }
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 1  # input size
          }
        }
      }
    }
  }
  input {
    name: "W"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 12 # gates_count*hidden_size
          }
          dim {
            dim_value: 1  # input size
          }
        }
      }
    }
  }
  input {
    name: "R"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 12 # gates_count*hidden_size
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
  input {
    name: "B"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 24 # 2*gates_count*hidden_size
          }
        }
      }
    }
  }
  input {
    name: "initial_h"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
  input {
    name: "initial_c"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
  output {
    name: "Y"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 3  # seq_length
          }
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
  output {
    name: "Y_h"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
  output {
    name: "Y_c"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_value: 1  # num_directions
          }
          dim {
            dim_value: 2  # batch size
          }
          dim {
            dim_value: 3  # hidden size
          }
        }
      }
    }
  }
}
opset_import {
  version: 14
}
